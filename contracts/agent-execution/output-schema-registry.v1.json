    {
      "key": "output.chapter_review_report.v1",
      "version": 1,
      "supported": true,
      "purpose": "evaluation",
      "sha256": "5ac5bee335c3b3b999489da656996ea220d05492e6c7c8d3d34def32c7b26877",
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentVerdict",
          "findings"
        ],
        "properties": {
          "contentVerdict": {
            "enum": [
              "pass",
              "issues_found",
              "cannot_assess"
            ]
          },
          "findings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension",
                "severity",
                "claim",
                "candidateRange",
                "evidence",
                "suggestion",
                "confidence"
              ],
              "properties": {
                "dimension": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                },
                "severity": {
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ]
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "candidateRange": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "startCodePoint",
                        "endCodePoint"
                      ],
                      "properties": {
                        "startCodePoint": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "endCodePoint": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidenceItemId",
                      "contentSha256",
                      "range"
                    ],
                    "properties": {
                      "evidenceItemId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      },
                      "contentSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "range": {
                        "anyOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "startCodePoint",
                              "endCodePoint"
                            ],
                            "properties": {
                              "startCodePoint": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "endCodePoint": {
                                "type": "integer",
                                "minimum": 1
                              }
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                },
                "suggestion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "contentVerdict": {
                  "const": "issues_found"
                }
              },
              "required": [
                "contentVerdict"
              ]
            },
            "then": {
              "properties": {
                "findings": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "findings": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
