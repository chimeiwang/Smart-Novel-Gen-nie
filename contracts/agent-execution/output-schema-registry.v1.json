    {
      "key": "output.beat_plan.v1",
      "version": 1,
      "supported": true,
      "purpose": "generation",
      "sha256": "711ef3169c19c540e5ac2dd7a25da87d510cc527fadf33b6331929a19f2be0cd",
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "summary": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "chapterGoal": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "sceneBeats": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "goal": {
                  "maxLength": 1000,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "conflict": {
                  "anyOf": [
                    {
                      "maxLength": 1000,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "characters": {
                  "items": {
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  "maxItems": 50,
                  "type": "array"
                },
                "foreshadowingRefs": {
                  "anyOf": [
                    {
                      "items": {
                        "maxLength": 200,
                        "minLength": 1,
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "maxItems": 50,
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "estimatedWords": {
                  "anyOf": [
                    {
                      "maximum": 2147483647,
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "acceptanceCriteria": {
                  "anyOf": [
                    {
                      "maxLength": 1000,
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "goal"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          "mainPlotConnection": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "chapterAcceptanceCriteria": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "totalEstimatedWords": {
            "anyOf": [
              {
                "maximum": 2147483647,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "summary",
          "chapterGoal",
          "sceneBeats"
        ],
        "type": "object"
      }
    },
