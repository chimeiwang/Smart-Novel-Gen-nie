{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkforge.cn/contracts/agent-execution/profile-registry.schema.json",
  "title": "InkForge Agent Execution Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "profiles"
  ],
  "properties": {
    "registryVersion": {
      "const": "1"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "versionedIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "deploymentProfileKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "supported",
        "reasoningMode",
        "purpose",
        "promptProfile",
        "deploymentProfileKey"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "supported": {
          "type": "boolean"
        },
        "reasoningMode": {
          "enum": [
            "disabled",
            "bounded"
          ]
        },
        "purpose": {
          "enum": [
            "generation",
            "review",
            "evaluation",
            "embedding",
            "media"
          ]
        },
        "promptProfile": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "deploymentProfileKey": {
          "$ref": "#/$defs/deploymentProfileKey"
        }
      }
    }
  }
}
