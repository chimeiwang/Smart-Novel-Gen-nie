{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkforge.cn/contracts/agent-execution/operation-catalog.schema.json",
  "title": "InkForge Agent Execution Operation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "operations"
  ],
  "properties": {
    "catalogVersion": {
      "const": "1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operationName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "operationKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "versionedIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN"
      ],
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "mode",
        "reviewerProfiles",
        "mergePolicy",
        "maxAutomaticRevisions",
        "onUnavailable"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "mode": {
          "enum": [
            "none",
            "single",
            "parallel"
          ]
        },
        "reviewerProfiles": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/versionedIdentifier"
          }
        },
        "reviewerStepBudgetProfiles": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/versionedIdentifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/versionedIdentifier"
          }
        },
        "reviewerOutputSchema": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "rubricVersion": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "evidencePolicy": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "lane": {
          "enum": [
            "interactive",
            "creative",
            "batch_media"
          ]
        },
        "mergePolicy": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "maxAutomaticRevisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "onUnavailable": {
          "enum": [
            "continue",
            "awaiting_user",
            "fail"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "reviewerProfiles": {
                "maxItems": 0
              },
              "maxAutomaticRevisions": {
                "const": 0
              },
              "onUnavailable": {
                "const": "continue"
              }
            }
          },
          "else": {
            "properties": {
              "reviewerProfiles": {
                "minItems": 1
              },
              "onUnavailable": {
                "const": "awaiting_user"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "single"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "reviewerProfiles": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "parallel"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "reviewerProfiles": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "runBudgetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "maxModelCalls",
        "maxInputTokens",
        "maxPromptCacheMissTokens",
        "maxCompletionTokens",
        "maxReasoningTokens",
        "maxVisibleOutputTokens",
        "maxCostMicros",
        "maxWallClockSeconds",
        "maxProtocolCorrectionSteps",
        "maxProviderRetriesPerStep"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxPromptCacheMissTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxCompletionTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "maxReasoningTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "maxVisibleOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "maxCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "maxWallClockSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxProtocolCorrectionSteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "maxProviderRetriesPerStep": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "workflow",
        "operation",
        "labels",
        "targetKinds",
        "scopeKinds",
        "mutating",
        "developmentOnly",
        "v2Enabled",
        "evidencePolicy",
        "generatorProfile",
        "outputSchema",
        "deterministicValidators",
        "reviewPolicy",
        "applyHandler",
        "runBudgetProfile",
        "lane"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/operationKey"
        },
        "workflow": {
          "$ref": "#/$defs/operationName"
        },
        "operation": {
          "$ref": "#/$defs/operationName"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "targetKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operationName"
          }
        },
        "scopeKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operationName"
          }
        },
        "mutating": {
          "type": "boolean"
        },
        "developmentOnly": {
          "type": "boolean"
        },
        "v2Enabled": {
          "type": "boolean"
        },
        "evidencePolicy": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "generatorProfile": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "generatorStepBudgetProfile": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "outputSchema": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "deterministicValidators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/versionedIdentifier"
          }
        },
        "reviewPolicy": {
          "$ref": "#/$defs/reviewPolicy"
        },
        "applyHandler": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "runBudgetProfile": {
          "$ref": "#/$defs/runBudgetProfile"
        },
        "lane": {
          "enum": [
            "interactive",
            "creative",
            "batch_media"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "v2Enabled": {
                "const": true
              }
            },
            "required": [
              "v2Enabled"
            ]
          },
          "then": {
            "required": [
              "generatorStepBudgetProfile"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reviewPolicy": {
                "properties": {
                  "mode": {
                    "enum": [
                      "single",
                      "parallel"
                    ]
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "v2Enabled": {
                "const": true
              }
            },
            "required": [
              "reviewPolicy",
              "v2Enabled"
            ]
          },
          "then": {
            "properties": {
              "reviewPolicy": {
                "required": [
                  "reviewerStepBudgetProfiles",
                  "reviewerOutputSchema",
                  "rubricVersion",
                  "evidencePolicy",
                  "lane"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
