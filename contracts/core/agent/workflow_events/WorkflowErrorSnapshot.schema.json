{
  "$id": "https://inkforge.local/contracts/agent/workflow_events/WorkflowErrorSnapshot/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "errorCode": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Errorcode",
      "type": "string"
    },
    "failedStepId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failedstepid"
    },
    "outcomeUnknown": {
      "title": "Outcomeunknown",
      "type": "boolean"
    }
  },
  "required": [
    "errorCode",
    "outcomeUnknown"
  ],
  "title": "WorkflowErrorSnapshot",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.workflow_events.WorkflowErrorSnapshot"
}
