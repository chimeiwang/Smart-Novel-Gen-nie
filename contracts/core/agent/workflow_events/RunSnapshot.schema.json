{
  "$defs": {
    "ModelProfileRef": {
      "additionalProperties": false,
      "description": "Core 授权的逻辑模型 Profile；不包含 Agent 部署配置。",
      "properties": {
        "deploymentProfileKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Deploymentprofilekey",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Profile",
          "type": "string"
        },
        "promptProfile": {
          "$ref": "#/$defs/PromptProfileRef"
        },
        "reasoningMode": {
          "enum": [
            "disabled",
            "bounded"
          ],
          "title": "Reasoningmode",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "version",
        "reasoningMode",
        "deploymentProfileKey",
        "promptProfile"
      ],
      "title": "ModelProfileRef",
      "type": "object"
    },
    "PromptProfileRef": {
      "additionalProperties": false,
      "description": "Manifest 管理的静态 system prompt 身份；正文由双端 Registry 按哈希校验。",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "PromptProfileRef",
      "type": "object"
    },
    "ResolvedModelRef": {
      "additionalProperties": false,
      "description": "Agent 对逻辑 Profile 的一次可审计部署解析。",
      "properties": {
        "capabilityVersion": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Capabilityversion",
          "type": "string"
        },
        "deploymentFingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Deploymentfingerprint",
          "type": "string"
        },
        "deploymentProfileKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Deploymentprofilekey",
          "type": "string"
        },
        "endpointProfile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Endpointprofile",
          "type": "string"
        },
        "model": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Provider",
          "type": "string"
        },
        "reasoningMode": {
          "enum": [
            "disabled",
            "bounded"
          ],
          "title": "Reasoningmode",
          "type": "string"
        },
        "structuredOutputRoute": {
          "enum": [
            "responses_json_schema_v1",
            "chat_json_output_v1"
          ],
          "title": "Structuredoutputroute",
          "type": "string"
        },
        "supportsRequestIdempotency": {
          "description": "仅当 Provider 确实原样传递 ExecutionStepRequest.idempotencyKey 时为 true",
          "title": "Supportsrequestidempotency",
          "type": "boolean"
        },
        "transportProfile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Transportprofile",
          "type": "string"
        }
      },
      "required": [
        "deploymentProfileKey",
        "deploymentFingerprint",
        "provider",
        "model",
        "transportProfile",
        "endpointProfile",
        "structuredOutputRoute",
        "capabilityVersion",
        "reasoningMode",
        "supportsRequestIdempotency"
      ],
      "title": "ResolvedModelRef",
      "type": "object"
    },
    "WorkflowArtifactSnapshot": {
      "additionalProperties": false,
      "properties": {
        "actionable": {
          "title": "Actionable",
          "type": "boolean"
        },
        "artifactId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Artifactid",
          "type": "string"
        },
        "artifactRevision": {
          "exclusiveMinimum": 0,
          "title": "Artifactrevision",
          "type": "integer"
        },
        "reviewAvailability": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewavailability"
        },
        "status": {
          "enum": [
            "draft",
            "under_review",
            "awaiting_user",
            "applying",
            "applied"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "artifactRevision",
        "status",
        "actionable"
      ],
      "title": "WorkflowArtifactSnapshot",
      "type": "object"
    },
    "WorkflowCurrentStepSnapshot": {
      "additionalProperties": false,
      "properties": {
        "attemptCount": {
          "minimum": 0,
          "title": "Attemptcount",
          "type": "integer"
        },
        "errorCode": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errorcode"
        },
        "fencingToken": {
          "minimum": 0,
          "title": "Fencingtoken",
          "type": "integer"
        },
        "lane": {
          "enum": [
            "control",
            "interactive",
            "creative",
            "batch_media"
          ],
          "title": "Lane",
          "type": "string"
        },
        "latestProgress": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowStepProgressSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelProfile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelProfileRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "exclusiveMinimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "purpose": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Purpose",
          "type": "string"
        },
        "resolvedModel": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedModelRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "stepId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Stepid",
          "type": "string"
        }
      },
      "required": [
        "stepId",
        "ordinal",
        "purpose",
        "lane",
        "modelProfile",
        "resolvedModel",
        "status",
        "attemptCount",
        "fencingToken",
        "latestProgress"
      ],
      "title": "WorkflowCurrentStepSnapshot",
      "type": "object"
    },
    "WorkflowErrorSnapshot": {
      "additionalProperties": false,
      "properties": {
        "errorCode": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Errorcode",
          "type": "string"
        },
        "failedStepId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failedstepid"
        },
        "outcomeUnknown": {
          "title": "Outcomeunknown",
          "type": "boolean"
        }
      },
      "required": [
        "errorCode",
        "outcomeUnknown"
      ],
      "title": "WorkflowErrorSnapshot",
      "type": "object"
    },
    "WorkflowRunSnapshot": {
      "additionalProperties": false,
      "properties": {
        "activeSteps": {
          "items": {
            "$ref": "#/$defs/WorkflowCurrentStepSnapshot"
          },
          "maxItems": 32,
          "title": "Activesteps",
          "type": "array"
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowArtifactSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cancelRequestedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancelrequestedat"
        },
        "currentStep": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowCurrentStepSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowErrorSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lastEventSequence": {
          "minimum": 0,
          "title": "Lasteventsequence",
          "type": "integer"
        },
        "operation": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "waiting_user",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "workflow": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "workflow",
        "status",
        "activeSteps",
        "lastEventSequence",
        "revision"
      ],
      "title": "WorkflowRunSnapshot",
      "type": "object"
    },
    "WorkflowStepProgressSnapshot": {
      "additionalProperties": false,
      "properties": {
        "elapsedSeconds": {
          "minimum": 0,
          "title": "Elapsedseconds",
          "type": "integer"
        },
        "phase": {
          "enum": [
            "preparing",
            "waiting_provider",
            "validating",
            "reporting"
          ],
          "title": "Phase",
          "type": "string"
        },
        "progressSequence": {
          "exclusiveMinimum": 0,
          "title": "Progresssequence",
          "type": "integer"
        },
        "usageStatus": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Usagestatus",
          "type": "string"
        },
        "waitingOnProvider": {
          "title": "Waitingonprovider",
          "type": "boolean"
        }
      },
      "required": [
        "progressSequence",
        "phase",
        "elapsedSeconds",
        "waitingOnProvider",
        "usageStatus"
      ],
      "title": "WorkflowStepProgressSnapshot",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/workflow_events/RunSnapshot/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseSequence": {
      "minimum": 0,
      "title": "Basesequence",
      "type": "integer"
    },
    "engineVersion": {
      "const": 2,
      "title": "Engineversion",
      "type": "integer"
    },
    "protocolVersion": {
      "const": "2.0",
      "title": "Protocolversion",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Runid",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/WorkflowRunSnapshot"
    }
  },
  "required": [
    "protocolVersion",
    "engineVersion",
    "runId",
    "baseSequence",
    "snapshot"
  ],
  "title": "RunSnapshot",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.workflow_events.RunSnapshot"
}
