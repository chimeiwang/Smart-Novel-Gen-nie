{
  "$defs": {
    "ModelProfileRef": {
      "additionalProperties": false,
      "description": "Core 授权的逻辑模型 Profile；不包含 Agent 部署配置。",
      "properties": {
        "deploymentProfileKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Deploymentprofilekey",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Profile",
          "type": "string"
        },
        "promptProfile": {
          "$ref": "#/$defs/PromptProfileRef"
        },
        "reasoningMode": {
          "enum": [
            "disabled",
            "bounded"
          ],
          "title": "Reasoningmode",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "version",
        "reasoningMode",
        "deploymentProfileKey",
        "promptProfile"
      ],
      "title": "ModelProfileRef",
      "type": "object"
    },
    "PromptProfileRef": {
      "additionalProperties": false,
      "description": "Manifest 管理的静态 system prompt 身份；正文由双端 Registry 按哈希校验。",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "PromptProfileRef",
      "type": "object"
    },
    "ReviewPendingStepSnapshot": {
      "additionalProperties": false,
      "properties": {
        "attemptCount": {
          "const": 0,
          "title": "Attemptcount",
          "type": "integer"
        },
        "fencingToken": {
          "const": 0,
          "title": "Fencingtoken",
          "type": "integer"
        },
        "lane": {
          "enum": [
            "control",
            "interactive",
            "creative",
            "batch_media"
          ],
          "title": "Lane",
          "type": "string"
        },
        "modelProfile": {
          "$ref": "#/$defs/ModelProfileRef"
        },
        "ordinal": {
          "exclusiveMinimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "purpose": {
          "const": "review",
          "title": "Purpose",
          "type": "string"
        },
        "status": {
          "const": "pending",
          "title": "Status",
          "type": "string"
        },
        "stepId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Stepid",
          "type": "string"
        }
      },
      "required": [
        "stepId",
        "ordinal",
        "purpose",
        "lane",
        "modelProfile",
        "status",
        "attemptCount",
        "fencingToken"
      ],
      "title": "ReviewPendingStepSnapshot",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/workflow_events/ReviewStartedEventPayload/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Artifactid",
      "type": "string"
    },
    "artifactRevision": {
      "exclusiveMinimum": 0,
      "title": "Artifactrevision",
      "type": "integer"
    },
    "reviewerSteps": {
      "items": {
        "$ref": "#/$defs/ReviewPendingStepSnapshot"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Reviewersteps",
      "type": "array"
    }
  },
  "required": [
    "artifactId",
    "artifactRevision",
    "reviewerSteps"
  ],
  "title": "ReviewStartedEventPayload",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.workflow_events.ReviewStartedEventPayload"
}
