{
  "$defs": {
    "ApplyingEventPayload": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Artifactid",
          "type": "string"
        },
        "artifactRevision": {
          "exclusiveMinimum": 0,
          "title": "Artifactrevision",
          "type": "integer"
        },
        "decisionStepId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Decisionstepid",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "artifactRevision",
        "decisionStepId"
      ],
      "title": "ApplyingEventPayload",
      "type": "object"
    },
    "AwaitingUserEventPayload": {
      "additionalProperties": false,
      "properties": {
        "allowedDecisions": {
          "items": {
            "enum": [
              "approve",
              "discard",
              "revise"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Alloweddecisions",
          "type": "array"
        },
        "artifactId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Artifactid",
          "type": "string"
        },
        "artifactRevision": {
          "exclusiveMinimum": 0,
          "title": "Artifactrevision",
          "type": "integer"
        },
        "reviewAvailability": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ],
          "title": "Reviewavailability",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "artifactRevision",
        "allowedDecisions",
        "reviewAvailability"
      ],
      "title": "AwaitingUserEventPayload",
      "type": "object"
    },
    "CancelledEventPayload": {
