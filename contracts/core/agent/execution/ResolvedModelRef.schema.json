{
  "$id": "https://inkforge.local/contracts/agent/execution/ResolvedModelRef/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent 对逻辑 Profile 的一次可审计部署解析。",
  "properties": {
    "capabilityVersion": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Capabilityversion",
      "type": "string"
    },
    "deploymentFingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deploymentfingerprint",
      "type": "string"
    },
    "deploymentProfileKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Deploymentprofilekey",
      "type": "string"
    },
    "endpointProfile": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Endpointprofile",
      "type": "string"
    },
    "model": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Provider",
      "type": "string"
    },
    "reasoningMode": {
      "enum": [
        "disabled",
        "bounded"
      ],
      "title": "Reasoningmode",
      "type": "string"
    },
    "structuredOutputRoute": {
      "enum": [
        "responses_json_schema_v1",
        "chat_json_output_v1"
      ],
      "title": "Structuredoutputroute",
      "type": "string"
    },
    "supportsRequestIdempotency": {
      "description": "仅当 Provider 确实原样传递 ExecutionStepRequest.idempotencyKey 时为 true",
      "title": "Supportsrequestidempotency",
      "type": "boolean"
    },
    "transportProfile": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Transportprofile",
      "type": "string"
    }
  },
  "required": [
    "deploymentProfileKey",
    "deploymentFingerprint",
    "provider",
    "model",
    "transportProfile",
    "endpointProfile",
    "structuredOutputRoute",
    "capabilityVersion",
    "reasoningMode",
    "supportsRequestIdempotency"
  ],
  "title": "ResolvedModelRef",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.execution.ResolvedModelRef"
}
