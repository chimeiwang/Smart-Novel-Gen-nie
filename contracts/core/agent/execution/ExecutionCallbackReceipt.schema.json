{
  "$id": "https://inkforge.local/contracts/agent/execution/ExecutionCallbackReceipt/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Core 的回调收据；stale 保留终态，其他状态确认无需再投递。",
  "properties": {
    "fencingToken": {
      "exclusiveMinimum": 0,
      "title": "Fencingtoken",
      "type": "integer"
    },
    "jobId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Jobid",
      "type": "string"
    },
    "protocolVersion": {
      "const": "2.0",
      "title": "Protocolversion",
      "type": "string"
    },
    "receivedAt": {
      "format": "date-time",
      "title": "Receivedat",
      "type": "string"
    },
    "requestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requesthash",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Runid",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "duplicate",
        "stale",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "stepId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Stepid",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "runId",
    "stepId",
    "jobId",
    "fencingToken",
    "requestHash",
    "status",
    "receivedAt"
  ],
  "title": "ExecutionCallbackReceipt",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.execution.ExecutionCallbackReceipt"
}
