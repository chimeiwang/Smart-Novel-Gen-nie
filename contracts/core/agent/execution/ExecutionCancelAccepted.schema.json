{
  "$id": "https://inkforge.local/contracts/agent/execution/ExecutionCancelAccepted/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptedAt": {
      "format": "date-time",
      "title": "Acceptedat",
      "type": "string"
    },
    "cancelRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Cancelrequestid",
      "type": "string"
    },
    "fencingToken": {
      "exclusiveMinimum": 0,
      "title": "Fencingtoken",
      "type": "integer"
    },
    "jobId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Jobid",
      "type": "string"
    },
    "novelId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Novelid"
    },
    "protocolVersion": {
      "const": "2.0",
      "title": "Protocolversion",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Runid",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "already_cancelled",
        "already_terminal",
        "not_found"
      ],
      "title": "Status",
      "type": "string"
    },
    "stepId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Stepid",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "cancelRequestId",
    "runId",
    "novelId",
    "stepId",
    "jobId",
    "fencingToken",
    "status",
    "acceptedAt"
  ],
  "title": "ExecutionCancelAccepted",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.execution.ExecutionCancelAccepted"
}
