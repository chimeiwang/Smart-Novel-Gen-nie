{
  "$defs": {
    "CommandClarification": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Code",
          "type": "string"
        },
        "prompt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "code",
        "prompt"
      ],
      "title": "CommandClarification",
      "type": "object"
    },
    "EvaluationEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "contentSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contentsha256",
          "type": "string"
        },
        "evidenceItemId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidenceitemid",
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "evidenceItemId",
        "contentSha256"
      ],
      "title": "EvaluationEvidenceReference",
      "type": "object"
    },
    "EvaluationFinding": {
      "additionalProperties": false,
      "properties": {
        "candidateRange": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claim": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "dimension": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Dimension",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvaluationEvidenceReference"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "severity",
        "claim",
        "evidence",
        "suggestion",
        "confidence"
      ],
      "title": "EvaluationFinding",
      "type": "object"
    },
    "EvidenceEvaluation": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifactid"
        },
        "artifactRevision": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifactrevision"
        },
        "contentVerdict": {
          "enum": [
            "pass",
            "issues_found",
            "cannot_assess"
          ],
          "title": "Contentverdict",
          "type": "string"
        },
        "evaluationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evaluationid",
          "type": "string"
        },
        "evaluatorProfile": {
          "$ref": "#/$defs/ModelProfileRef"
        },
        "evidenceBundleId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidencebundleid",
          "type": "string"
        },
        "executionStatus": {
          "enum": [
            "completed",
            "incomplete",
            "failed"
          ],
          "title": "Executionstatus",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/EvaluationFinding"
          },
          "maxItems": 100,
          "title": "Findings",
          "type": "array"
        },
        "resolvedModel": {
          "$ref": "#/$defs/ResolvedModelRef"
        },
        "rubricVersion": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Rubricversion",
          "type": "string"
        },
        "runId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Runid",
          "type": "string"
        },
        "stepId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Stepid",
          "type": "string"
        }
      },
      "required": [
        "evaluationId",
        "runId",
        "stepId",
        "evidenceBundleId",
        "evaluatorProfile",
        "resolvedModel",
        "rubricVersion",
        "executionStatus",
        "contentVerdict"
      ],
      "title": "EvidenceEvaluation",
      "type": "object"
    },
    "EvidenceExpansionItem": {
      "additionalProperties": false,
      "properties": {
        "purposeCode": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Purposecode",
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Resourceid",
          "type": "string"
        },
        "resourceType": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Resourcetype",
          "type": "string"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "purposeCode"
      ],
      "title": "EvidenceExpansionItem",
      "type": "object"
    },
    "EvidenceExpansionRequest": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/EvidenceExpansionItem"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "maxAdditionalBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxadditionalbytes",
          "type": "integer"
        },
        "reasonCode": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Reasoncode",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Requestid",
          "type": "string"
        },
        "sourceBundleId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Sourcebundleid",
          "type": "string"
        },
        "sourceBundleVersion": {
          "exclusiveMinimum": 0,
          "title": "Sourcebundleversion",
          "type": "integer"
        }
      },
      "required": [
        "requestId",
        "sourceBundleId",
        "sourceBundleVersion",
        "reasonCode",
        "maxAdditionalBytes",
        "items"
      ],
      "title": "EvidenceExpansionRequest",
      "type": "object"
    },
    "EvidenceRange": {
      "additionalProperties": false,
      "description": "以 Unicode 码点计数的半开区间。",
      "properties": {
        "endCodePoint": {
          "exclusiveMinimum": 0,
          "title": "Endcodepoint",
          "type": "integer"
        },
        "startCodePoint": {
          "minimum": 0,
          "title": "Startcodepoint",
          "type": "integer"
        }
      },
      "required": [
        "startCodePoint",
        "endCodePoint"
      ],
      "title": "EvidenceRange",
      "type": "object"
    },
    "JsonValue": {},
    "ModelProfileRef": {
      "additionalProperties": false,
      "description": "Core 授权的逻辑模型 Profile；不包含 Agent 部署配置。",
      "properties": {
        "deploymentProfileKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Deploymentprofilekey",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Profile",
          "type": "string"
        },
        "promptProfile": {
          "$ref": "#/$defs/PromptProfileRef"
        },
        "reasoningMode": {
          "enum": [
            "disabled",
            "bounded"
          ],
          "title": "Reasoningmode",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "version",
        "reasoningMode",
        "deploymentProfileKey",
        "promptProfile"
      ],
      "title": "ModelProfileRef",
      "type": "object"
    },
    "PromptProfileRef": {
      "additionalProperties": false,
      "description": "Manifest 管理的静态 system prompt 身份；正文由双端 Registry 按哈希校验。",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "PromptProfileRef",
      "type": "object"
    },
    "ProposedCommand": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "clarification": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandClarification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "operation": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "scopeKind": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scopekind"
        },
        "targetId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetid"
        },
        "targetType": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targettype"
        },
        "workflow": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        }
      },
      "required": [
        "confidence"
      ],
      "title": "ProposedCommand",
      "type": "object"
    },
    "ResolvedModelRef": {
      "additionalProperties": false,
      "description": "Agent 对逻辑 Profile 的一次可审计部署解析。",
      "properties": {
        "capabilityVersion": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Capabilityversion",
          "type": "string"
        },
        "deploymentFingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Deploymentfingerprint",
          "type": "string"
        },
        "deploymentProfileKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Deploymentprofilekey",
          "type": "string"
        },
        "endpointProfile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Endpointprofile",
          "type": "string"
        },
        "model": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Provider",
          "type": "string"
        },
        "reasoningMode": {
          "enum": [
            "disabled",
            "bounded"
          ],
          "title": "Reasoningmode",
          "type": "string"
        },
        "structuredOutputRoute": {
          "enum": [
            "responses_json_schema_v1",
            "chat_json_output_v1"
          ],
          "title": "Structuredoutputroute",
          "type": "string"
        },
        "supportsRequestIdempotency": {
          "description": "仅当 Provider 确实原样传递 ExecutionStepRequest.idempotencyKey 时为 true",
          "title": "Supportsrequestidempotency",
          "type": "boolean"
        },
        "transportProfile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Transportprofile",
          "type": "string"
        }
      },
      "required": [
        "deploymentProfileKey",
        "deploymentFingerprint",
        "provider",
        "model",
        "transportProfile",
        "endpointProfile",
        "structuredOutputRoute",
        "capabilityVersion",
        "reasoningMode",
        "supportsRequestIdempotency"
      ],
      "title": "ResolvedModelRef",
      "type": "object"
    },
    "StepUsage": {
      "additionalProperties": false,
      "properties": {
        "cachedTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cachedtokens"
        },
        "completionTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completiontokens"
        },
        "costMicros": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costmicros"
        },
        "inputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputtokens"
        },
        "promptCacheMissTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promptcachemisstokens"
        },
        "protocolCorrections": {
          "maximum": 1,
          "minimum": 0,
          "title": "Protocolcorrections",
          "type": "integer"
        },
        "providerAttempts": {
          "maximum": 3,
          "minimum": 0,
          "title": "Providerattempts",
          "type": "integer"
        },
        "reasoningTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoningtokens"
        },
        "usageStatus": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Usagestatus",
          "type": "string"
        },
        "visibleOutputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visibleoutputtokens"
        },
        "wallTimeMillis": {
          "minimum": 0,
          "title": "Walltimemillis",
          "type": "integer"
        }
      },
      "required": [
        "usageStatus",
        "providerAttempts",
        "protocolCorrections",
        "wallTimeMillis"
      ],
      "title": "StepUsage",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/execution/ExecutionStepResult/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completedAt": {
      "format": "date-time",
      "title": "Completedat",
      "type": "string"
    },
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceEvaluation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidenceExpansion": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceExpansionRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fencingToken": {
      "exclusiveMinimum": 0,
      "title": "Fencingtoken",
      "type": "integer"
    },
    "inputHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inputhash",
      "type": "string"
    },
    "jobId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Jobid",
      "type": "string"
    },
    "novelId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Novelid"
    },
    "output": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "proposedCommand": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposedCommand"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "protocolVersion": {
      "const": "2.0",
      "title": "Protocolversion",
      "type": "string"
    },
    "requestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requesthash",
      "type": "string"
    },
    "resolvedModel": {
      "$ref": "#/$defs/ResolvedModelRef"
    },
    "resultHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resulthash",
      "type": "string"
    },
    "resultKind": {
      "enum": [
        "output",
        "evidence_expansion",
        "proposed_command",
        "evaluation"
      ],
      "title": "Resultkind",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Runid",
      "type": "string"
    },
    "stepId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Stepid",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/StepUsage"
    }
  },
  "required": [
    "protocolVersion",
    "jobId",
    "runId",
    "novelId",
    "stepId",
    "fencingToken",
    "requestHash",
    "inputHash",
    "resolvedModel",
    "resultKind",
    "resultHash",
    "usage",
    "completedAt"
  ],
  "title": "ExecutionStepResult",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.execution.ExecutionStepResult"
}
