{
  "$defs": {
    "EvidenceRange": {
      "additionalProperties": false,
      "description": "以 Unicode 码点计数的半开区间。",
      "properties": {
        "endCodePoint": {
          "exclusiveMinimum": 0,
          "title": "Endcodepoint",
          "type": "integer"
        },
        "startCodePoint": {
          "minimum": 0,
          "title": "Startcodepoint",
          "type": "integer"
        }
      },
      "required": [
        "startCodePoint",
        "endCodePoint"
      ],
      "title": "EvidenceRange",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/execution/EvaluationEvidenceReference/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contentSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contentsha256",
      "type": "string"
    },
    "evidenceItemId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Evidenceitemid",
      "type": "string"
    },
    "range": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "evidenceItemId",
    "contentSha256"
  ],
  "title": "EvaluationEvidenceReference",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.execution.EvaluationEvidenceReference"
}
