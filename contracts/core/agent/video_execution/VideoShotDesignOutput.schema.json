{
  "$defs": {
    "BeatCoverageGoal": {
      "additionalProperties": false,
      "description": "一个节拍希望观众获得的内容，不预设必须使用哪类镜头完成。",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "goalKey": {
          "pattern": "^G[0-9]{2,3}$",
          "title": "Goalkey",
          "type": "string"
        },
        "kind": {
          "enum": [
            "story_information",
            "action",
            "emotion",
            "space",
            "relationship",
            "motif",
            "transition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "priority": {
          "enum": [
            "essential",
            "supporting"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "goalKey",
        "kind",
        "priority",
        "description"
      ],
      "title": "BeatCoverageGoal",
      "type": "object"
    },
    "ChapterAdaptationPlanCandidate": {
      "additionalProperties": false,
      "description": "进入 ReviewArtifact 的完整 Scene → Beat → Shot 候选。",
      "properties": {
        "adaptationId": {
          "minLength": 1,
          "title": "Adaptationid",
          "type": "string"
        },
        "reviewFindings": {
          "items": {
            "$ref": "#/$defs/CinematicReviewFinding"
          },
          "maxItems": 480,
          "title": "Reviewfindings",
          "type": "array"
        },
        "reviewSummary": {
          "anyOf": [
            {
              "maxLength": 1200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewsummary"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/CinematicSceneCandidate"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "schemaVersion": {
          "const": "chapter_adaptation_plan_v3",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourceHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcehash",
          "type": "string"
        },
        "suggestedEpisodeBreakAfterShotKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 119,
          "title": "Suggestedepisodebreakaftershotkeys",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "adaptationId",
        "sourceHash",
        "scenes"
      ],
      "title": "ChapterAdaptationPlanCandidate",
      "type": "object"
    },
    "ChapterAdaptationSourceRange": {
      "additionalProperties": false,
      "description": "相对于不可变章节全文的 Unicode code point 左闭右开范围。",
      "properties": {
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "sourceText": {
          "maxLength": 120000,
          "minLength": 1,
          "title": "Sourcetext",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "sourceText"
      ],
      "title": "ChapterAdaptationSourceRange",
      "type": "object"
    },
    "CinematicReviewFinding": {
      "additionalProperties": false,
      "description": "面向作者的非阻断审镜发现。",
      "properties": {
        "evidence": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "message": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "scope": {
          "enum": [
            "plan",
            "scene",
            "beat",
            "shot"
          ],
          "title": "Scope",
          "type": "string"
        },
        "scopeKey": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scopekey"
        },
        "severity": {
          "enum": [
            "notice",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "scope",
        "message",
        "evidence",
        "suggestion"
      ],
      "title": "CinematicReviewFinding",
      "type": "object"
    },
    "CinematicSceneCandidate": {
      "additionalProperties": false,
      "description": "由时间、地点和连续行动空间决定的真实场景候选。",
      "properties": {
        "beats": {
          "items": {
            "$ref": "#/$defs/DramaticBeatCandidate"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "changeSummary": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Changesummary",
          "type": "string"
        },
        "locationLabel": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Locationlabel",
          "type": "string"
        },
        "objective": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "sceneKey": {
          "pattern": "^SC[0-9]{2,3}$",
          "title": "Scenekey",
          "type": "string"
        },
        "timeLabel": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Timelabel",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "sceneKey",
        "title",
        "locationLabel",
        "timeLabel",
        "objective",
        "changeSummary",
        "beats"
      ],
      "title": "CinematicSceneCandidate",
      "type": "object"
    },
    "CinematicShotCandidate": {
      "additionalProperties": false,
      "description": "候选镜头是一段连续机位和一个主要可见动作。",
      "properties": {
        "audienceGain": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Audiencegain",
          "type": "string"
        },
        "cameraAngle": {
          "enum": [
            "eye_level",
            "high_angle",
            "low_angle",
            "overhead",
            "dutch_angle"
          ],
          "title": "Cameraangle",
          "type": "string"
        },
        "cameraMovement": {
          "enum": [
            "locked",
            "pan",
            "tilt",
            "push_in",
            "pull_out",
            "tracking",
            "arc",
            "handheld",
            "focus_shift"
          ],
          "title": "Cameramovement",
          "type": "string"
        },
        "coveredGoalKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Coveredgoalkeys",
          "type": "array"
        },
        "cutReason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Cutreason",
          "type": "string"
        },
        "narrativePurpose": {
          "enum": [
            "establishing",
            "action",
            "dialogue",
            "reaction",
            "reveal",
            "insert",
            "transition",
            "atmosphere"
          ],
          "title": "Narrativepurpose",
          "type": "string"
        },
        "shotKey": {
          "pattern": "^S[0-9]{2,3}$",
          "title": "Shotkey",
          "type": "string"
        },
        "shotScale": {
          "enum": [
            "extreme_long",
            "long",
            "medium",
            "medium_close",
            "close",
            "extreme_close",
            "over_shoulder",
            "two_shot",
            "pov"
          ],
          "title": "Shotscale",
          "type": "string"
        },
        "soundDesign": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Sounddesign",
          "type": "string"
        },
        "sourceRanges": {
          "items": {
            "$ref": "#/$defs/ChapterAdaptationSourceRange"
          },
          "maxItems": 12,
          "title": "Sourceranges",
          "type": "array"
        },
        "sourceRelation": {
          "enum": [
            "direct",
            "derived",
            "supplemental"
          ],
          "title": "Sourcerelation",
          "type": "string"
        },
        "speechMode": {
          "enum": [
            "none",
            "sync",
            "offscreen",
            "voiceover"
          ],
          "title": "Speechmode",
          "type": "string"
        },
        "spokenText": {
          "anyOf": [
            {
              "maxLength": 800,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spokentext"
        },
        "storyFunction": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Storyfunction",
          "type": "string"
        },
        "timelineDurationMs": {
          "maximum": 15000,
          "minimum": 500,
          "title": "Timelinedurationms",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visualIntent": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Visualintent",
          "type": "string"
        }
      },
      "required": [
        "shotKey",
        "title",
        "narrativePurpose",
        "storyFunction",
        "audienceGain",
        "sourceRelation",
        "shotScale",
        "cameraAngle",
        "cameraMovement",
        "visualIntent",
        "speechMode",
        "soundDesign",
        "cutReason",
        "timelineDurationMs",
        "sourceRanges"
      ],
      "title": "CinematicShotCandidate",
      "type": "object"
    },
    "CinematicShotDesignDraft": {
      "additionalProperties": false,
      "description": "模型第二阶段在服务器指定的 Beat 槽内，只引用 sourceUnitIds 和 Goal Key。",
      "properties": {
        "audienceGain": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Audiencegain",
          "type": "string"
        },
        "cameraAngle": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cameraangle",
          "type": "string"
        },
        "cameraMovement": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cameramovement",
          "type": "string"
        },
        "coveredGoalKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Coveredgoalkeys",
          "type": "array"
        },
        "cutReason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Cutreason",
          "type": "string"
        },
        "narrativePurpose": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Narrativepurpose",
          "type": "string"
        },
        "shotScale": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Shotscale",
          "type": "string"
        },
        "soundDesign": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Sounddesign",
          "type": "string"
        },
        "sourceRelation": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Sourcerelation",
          "type": "string"
        },
        "sourceUnitIds": {
          "items": {
            "type": "string"
          },
          "title": "Sourceunitids",
          "type": "array"
        },
        "speechMode": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Speechmode",
          "type": "string"
        },
        "spokenText": {
          "anyOf": [
            {
              "maxLength": 800,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spokentext"
        },
        "storyFunction": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Storyfunction",
          "type": "string"
        },
        "timelineDurationMs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Timelinedurationms"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visualIntent": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Visualintent",
          "type": "string"
        }
      },
      "required": [
        "title",
        "narrativePurpose",
        "storyFunction",
        "audienceGain",
        "coveredGoalKeys",
        "sourceRelation",
        "shotScale",
        "cameraAngle",
        "cameraMovement",
        "visualIntent",
        "speechMode",
        "soundDesign",
        "cutReason",
        "timelineDurationMs",
        "sourceUnitIds"
      ],
      "title": "CinematicShotDesignDraft",
      "type": "object"
    },
    "CinematicShotDesignResult": {
      "additionalProperties": false,
      "properties": {
        "beatsByKey": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/CinematicShotDesignDraft"
            },
            "type": "array"
          },
          "title": "Beatsbykey",
          "type": "object"
        },
        "suggestedEpisodeBreakAfterShotNumbers": {
          "items": {
            "type": "integer"
          },
          "title": "Suggestedepisodebreakaftershotnumbers",
          "type": "array"
        }
      },
      "required": [
        "beatsByKey"
      ],
      "title": "CinematicShotDesignResult",
      "type": "object"
    },
    "DramaticBeatCandidate": {
      "additionalProperties": false,
      "description": "戏剧节拍表达人物目标、信息、情绪、权力或行动结果的变化。",
      "properties": {
        "beatKey": {
          "pattern": "^B[0-9]{2,3}$",
          "title": "Beatkey",
          "type": "string"
        },
        "coverageGoals": {
          "items": {
            "$ref": "#/$defs/BeatCoverageGoal"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Coveragegoals",
          "type": "array"
        },
        "dramaticTurn": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Dramaticturn",
          "type": "string"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/CinematicShotCandidate"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Shots",
          "type": "array"
        },
        "sourceRanges": {
          "items": {
            "$ref": "#/$defs/ChapterAdaptationSourceRange"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Sourceranges",
          "type": "array"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visualStrategy": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Visualstrategy",
          "type": "string"
        }
      },
      "required": [
        "beatKey",
        "title",
        "dramaticTurn",
        "visualStrategy",
        "coverageGoals",
        "sourceRanges",
        "shots"
      ],
      "title": "DramaticBeatCandidate",
      "type": "object"
    },
    "VideoActionCountParameters": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "minimum": 0,
          "title": "Actual",
          "type": "integer"
        },
        "durationMs": {
          "maximum": 15000,
          "minimum": 500,
          "title": "Durationms",
          "type": "integer"
        },
        "maximum": {
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "required": [
        "actual",
        "maximum",
        "durationMs"
      ],
      "title": "VideoActionCountParameters",
      "type": "object"
    },
    "VideoActionParameters": {
      "additionalProperties": false,
      "properties": {
        "markers": {
          "items": {
            "enum": [
              "凝成",
              "亮起",
              "熄灭",
              "弹开",
              "打开",
              "关闭",
              "碎裂",
              "破裂",
              "加速",
              "减速",
              "转为",
              "变成",
              "显现",
              "消失",
              "再次",
              "再度",
              "又一次",
              "反复",
              "继续",
              "重试",
              "回拧",
              "反向",
              "转动",
              "旋转"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Markers",
          "type": "array"
        }
      },
      "required": [
        "markers"
      ],
      "title": "VideoActionParameters",
      "type": "object"
    },
    "VideoCountParameters": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "minimum": 0,
          "title": "Actual",
          "type": "integer"
        },
        "maximum": {
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "required": [
        "actual",
        "maximum"
      ],
      "title": "VideoCountParameters",
      "type": "object"
    },
    "VideoEffectParameters": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "items": {
            "enum": [
              "火花",
              "火焰",
              "爆炸",
              "闪电或电弧",
              "粒子效果",
              "光束或光柱",
              "浓烟",
              "雨雪",
              "血迹"
            ],
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        }
      },
      "required": [
        "effects"
      ],
      "title": "VideoEffectParameters",
      "type": "object"
    },
    "VideoNoParameters": {
      "additionalProperties": false,
      "properties": {},
      "title": "VideoNoParameters",
      "type": "object"
    },
    "VideoRepeatedFieldParameters": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "enum": [
              "subjectAndScene",
              "visibleAction",
              "expressionAndGaze",
              "camera",
              "audio"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "fields"
      ],
      "title": "VideoRepeatedFieldParameters",
      "type": "object"
    },
    "VideoScaleParameters": {
      "additionalProperties": false,
      "properties": {
        "conflictingScales": {
          "items": {
            "enum": [
              "过肩镜头",
              "双人镜头",
              "主观镜头",
              "大特写",
              "中近景",
              "大全景",
              "大远景",
              "特写",
              "近景",
              "中景",
              "全景",
              "远景"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Conflictingscales",
          "type": "array"
        },
        "requiredScale": {
          "enum": [
            "过肩镜头",
            "双人镜头",
            "主观镜头",
            "大特写",
            "中近景",
            "大全景",
            "大远景",
            "特写",
            "近景",
            "中景",
            "全景",
            "远景"
          ],
          "title": "Requiredscale",
          "type": "string"
        }
      },
      "required": [
        "requiredScale",
        "conflictingScales"
      ],
      "title": "VideoScaleParameters",
      "type": "object"
    },
    "VideoStageValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "enum": [
            "protocol_invalid",
            "dramatic_protocol",
            "dramatic_materialization",
            "design_protocol",
            "design_materialization",
            "prompt_schema",
            "prompt_target_order",
            "prompt_performance",
            "prompt_continuity",
            "prompt_metadata",
            "prompt_neighbor",
            "prompt_scale",
            "prompt_action_count",
            "prompt_expression_invisible",
            "prompt_expression_micro",
            "prompt_expression_interpretation",
            "prompt_action_interpretation",
            "prompt_effects",
            "prompt_affirmative_effects",
            "prompt_unconfirmed_action",
            "prompt_required_hand_blocked",
            "prompt_required_subject_blocked",
            "prompt_required_hand_missing",
            "prompt_repeated_fields",
            "prompt_compile",
            "prompt_budget"
          ],
          "title": "Code",
          "type": "string"
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoNoParameters"
            },
            {
              "$ref": "#/$defs/VideoActionCountParameters"
            },
            {
              "$ref": "#/$defs/VideoCountParameters"
            },
            {
              "$ref": "#/$defs/VideoScaleParameters"
            },
            {
              "$ref": "#/$defs/VideoEffectParameters"
            },
            {
              "$ref": "#/$defs/VideoActionParameters"
            },
            {
              "$ref": "#/$defs/VideoRepeatedFieldParameters"
            }
          ],
          "title": "Parameters"
        },
        "shotKey": {
          "anyOf": [
            {
              "pattern": "^S[0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shotkey"
        }
      },
      "required": [
        "code",
        "shotKey",
        "parameters",
        "blocking"
      ],
      "title": "VideoStageValidationFinding",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/video_execution/VideoShotDesignOutput/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChapterAdaptationPlanCandidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "design": {
      "anyOf": [
        {
          "$ref": "#/$defs/CinematicShotDesignResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "missingBeatKeys": {
      "items": {
        "pattern": "^B[0-9]{2,3}$",
