{
  "$defs": {
    "SeedanceShotPromptSpec": {
      "additionalProperties": false,
      "description": "模型只填结构化内容，最终即梦文本由纯函数按固定顺序编译。",
      "properties": {
        "audio": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Audio",
          "type": "string"
        },
        "camera": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Camera",
          "type": "string"
        },
        "continuity": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuity"
        },
        "expressionAndGaze": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expressionandgaze"
        },
        "negativeConstraints": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Negativeconstraints",
          "type": "array"
        },
        "performance": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Performance"
        },
        "subjectAndScene": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Subjectandscene",
          "type": "string"
        },
        "visibleAction": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Visibleaction",
          "type": "string"
        }
      },
      "required": [
        "subjectAndScene",
        "visibleAction",
        "camera",
        "audio"
      ],
      "title": "SeedanceShotPromptSpec",
      "type": "object"
    },
    "ShotPromptSpecBatch": {
      "additionalProperties": false,
      "properties": {
        "prompts": {
          "items": {
            "$ref": "#/$defs/ShotPromptSpecCandidate"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Prompts",
          "type": "array"
        },
        "schemaVersion": {
          "const": "shot_prompt_spec_batch_v2",
          "default": "shot_prompt_spec_batch_v2",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "prompts"
      ],
      "title": "ShotPromptSpecBatch",
      "type": "object"
    },
    "ShotPromptSpecCandidate": {
      "additionalProperties": false,
      "properties": {
        "qualityWarnings": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Qualitywarnings",
          "type": "array"
        },
        "shotKey": {
          "pattern": "^S[0-9]{2,3}$",
          "title": "Shotkey",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/SeedanceShotPromptSpec"
        }
      },
      "required": [
        "shotKey",
        "spec"
      ],
      "title": "ShotPromptSpecCandidate",
      "type": "object"
    },
    "VideoActionCountParameters": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "minimum": 0,
          "title": "Actual",
          "type": "integer"
        },
        "durationMs": {
          "maximum": 15000,
          "minimum": 500,
          "title": "Durationms",
          "type": "integer"
        },
        "maximum": {
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "required": [
        "actual",
        "maximum",
        "durationMs"
      ],
      "title": "VideoActionCountParameters",
      "type": "object"
    },
    "VideoActionParameters": {
      "additionalProperties": false,
      "properties": {
        "markers": {
          "items": {
            "enum": [
              "凝成",
              "亮起",
              "熄灭",
              "弹开",
              "打开",
              "关闭",
              "碎裂",
              "破裂",
              "加速",
              "减速",
              "转为",
              "变成",
              "显现",
              "消失",
              "再次",
              "再度",
              "又一次",
              "反复",
              "继续",
              "重试",
              "回拧",
              "反向",
              "转动",
              "旋转"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Markers",
          "type": "array"
        }
      },
      "required": [
        "markers"
      ],
      "title": "VideoActionParameters",
      "type": "object"
    },
    "VideoCountParameters": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "minimum": 0,
          "title": "Actual",
          "type": "integer"
        },
        "maximum": {
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "required": [
        "actual",
        "maximum"
      ],
      "title": "VideoCountParameters",
      "type": "object"
    },
    "VideoEffectParameters": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "items": {
            "enum": [
              "火花",
              "火焰",
              "爆炸",
              "闪电或电弧",
              "粒子效果",
              "光束或光柱",
              "浓烟",
              "雨雪",
              "血迹"
            ],
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        }
      },
      "required": [
        "effects"
      ],
      "title": "VideoEffectParameters",
      "type": "object"
    },
    "VideoNoParameters": {
      "additionalProperties": false,
      "properties": {},
      "title": "VideoNoParameters",
      "type": "object"
    },
    "VideoRepeatedFieldParameters": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "enum": [
              "subjectAndScene",
              "visibleAction",
              "expressionAndGaze",
              "camera",
              "audio"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "fields"
      ],
      "title": "VideoRepeatedFieldParameters",
      "type": "object"
    },
    "VideoScaleParameters": {
      "additionalProperties": false,
      "properties": {
        "conflictingScales": {
          "items": {
            "enum": [
              "过肩镜头",
              "双人镜头",
              "主观镜头",
              "大特写",
              "中近景",
              "大全景",
              "大远景",
              "特写",
              "近景",
              "中景",
              "全景",
              "远景"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Conflictingscales",
          "type": "array"
        },
        "requiredScale": {
          "enum": [
            "过肩镜头",
            "双人镜头",
            "主观镜头",
            "大特写",
            "中近景",
            "大全景",
            "大远景",
            "特写",
            "近景",
            "中景",
            "全景",
            "远景"
          ],
          "title": "Requiredscale",
          "type": "string"
        }
      },
      "required": [
        "requiredScale",
        "conflictingScales"
      ],
      "title": "VideoScaleParameters",
      "type": "object"
    },
    "VideoStageValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "enum": [
            "protocol_invalid",
            "dramatic_protocol",
            "dramatic_materialization",
            "design_protocol",
            "design_materialization",
            "prompt_schema",
            "prompt_target_order",
            "prompt_performance",
            "prompt_continuity",
            "prompt_metadata",
            "prompt_neighbor",
            "prompt_scale",
            "prompt_action_count",
            "prompt_expression_invisible",
            "prompt_expression_micro",
            "prompt_expression_interpretation",
            "prompt_action_interpretation",
            "prompt_effects",
            "prompt_affirmative_effects",
            "prompt_unconfirmed_action",
            "prompt_required_hand_blocked",
            "prompt_required_subject_blocked",
            "prompt_required_hand_missing",
            "prompt_repeated_fields",
            "prompt_compile",
            "prompt_budget"
          ],
          "title": "Code",
          "type": "string"
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoNoParameters"
            },
            {
              "$ref": "#/$defs/VideoActionCountParameters"
            },
            {
              "$ref": "#/$defs/VideoCountParameters"
            },
            {
              "$ref": "#/$defs/VideoScaleParameters"
            },
            {
              "$ref": "#/$defs/VideoEffectParameters"
            },
            {
              "$ref": "#/$defs/VideoActionParameters"
            },
            {
              "$ref": "#/$defs/VideoRepeatedFieldParameters"
            }
          ],
          "title": "Parameters"
        },
        "shotKey": {
          "anyOf": [
            {
              "pattern": "^S[0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shotkey"
        }
      },
      "required": [
        "code",
        "shotKey",
        "parameters",
        "blocking"
      ],
      "title": "VideoStageValidationFinding",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/video_execution/VideoShotPromptOutput/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "enum": [
        "ready",
        "needs_correction"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "promptBatch": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShotPromptSpecBatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "stageKey": {
      "const": "shot_prompt",
      "title": "Stagekey",
      "type": "string"
    },
    "validationFindings": {
      "items": {
        "$ref": "#/$defs/VideoStageValidationFinding"
      },
      "title": "Validationfindings",
      "type": "array"
    }
  },
  "required": [
    "validationFindings",
    "stageKey",
    "outcome",
    "promptBatch"
  ],
  "title": "VideoShotPromptOutput",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video_execution.VideoShotPromptOutput"
}
