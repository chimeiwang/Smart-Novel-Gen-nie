{
  "$defs": {
    "VideoStoryboardReferenceChoice": {
      "additionalProperties": false,
      "description": "模型只选择已冻结版本及强度，其余不可变事实由 Core 回填。",
      "properties": {
        "canonVersionId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonversionid",
          "type": "string"
        },
        "strength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        }
      },
      "required": [
        "canonVersionId"
      ],
      "title": "VideoStoryboardReferenceChoice",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/video_storyboard/VideoStoryboardProductionIntentProposal/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "durationSeconds": {
      "maximum": 12,
      "minimum": 4,
      "title": "Durationseconds",
      "type": "integer"
    },
    "executionMode": {
      "const": "simulated",
      "default": "simulated",
      "title": "Executionmode",
      "type": "string"
    },
    "feeConfirmed": {
      "const": false,
      "default": false,
      "title": "Feeconfirmed",
      "type": "boolean"
    },
    "generateAudio": {
      "default": true,
      "title": "Generateaudio",
      "type": "boolean"
    },
    "generationMode": {
      "const": "reference",
      "default": "reference",
      "title": "Generationmode",
      "type": "string"
    },
    "model": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "outputFormat": {
      "const": "mp4",
      "default": "mp4",
      "title": "Outputformat",
      "type": "string"
    },
    "prompt": {
      "maxLength": 2500,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "provider": {
      "const": "seedance",
      "default": "seedance",
      "title": "Provider",
      "type": "string"
    },
    "ratio": {
      "enum": [
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16",
        "21:9",
        "adaptive"
      ],
      "title": "Ratio",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/VideoStoryboardReferenceChoice"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "References",
      "type": "array"
    },
    "resolution": {
      "const": "720p",
      "default": "720p",
      "title": "Resolution",
      "type": "string"
    },
    "watermark": {
      "default": false,
      "title": "Watermark",
      "type": "boolean"
    }
  },
  "required": [
    "model",
    "ratio",
    "prompt",
    "durationSeconds",
    "references"
  ],
  "title": "VideoStoryboardProductionIntentProposal",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video_storyboard.VideoStoryboardProductionIntentProposal"
