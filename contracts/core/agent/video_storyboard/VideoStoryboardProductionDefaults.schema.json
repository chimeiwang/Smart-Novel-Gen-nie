      "title": "Executionmode",
      "type": "string"
    },
    "feeConfirmed": {
      "const": false,
      "default": false,
      "title": "Feeconfirmed",
      "type": "boolean"
    },
    "generateAudio": {
      "default": true,
      "title": "Generateaudio",
      "type": "boolean"
    },
    "generationMode": {
      "const": "reference",
      "default": "reference",
      "title": "Generationmode",
      "type": "string"
    },
    "model": {
