      "default": "seedance",
      "title": "Provider",
      "type": "string"
    },
    "ratio": {
      "enum": [
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16",
        "21:9",
        "adaptive"
      ],
      "title": "Ratio",
      "type": "string"
    },
    "resolution": {
      "const": "720p",
      "default": "720p",
      "title": "Resolution",
      "type": "string"
    },
    "watermark": {
      "default": false,
      "title": "Watermark",
      "type": "boolean"
    }
