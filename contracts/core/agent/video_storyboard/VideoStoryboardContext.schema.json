  "$id": "https://inkforge.local/contracts/agent/video_storyboard/VideoStoryboardContext/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "availableReferences": {
      "items": {
        "$ref": "#/$defs/VideoStoryboardReferenceEvidence"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Availablereferences",
      "type": "array"
    },
    "baseStoryboardVersionId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Basestoryboardversionid"
    },
    "draft": {
      "$ref": "#/$defs/VideoStoryboardDocument"
    },
    "draftContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draftcontenthash",
      "type": "string"
    },
    "draftRevision": {
      "minimum": 1,
      "title": "Draftrevision",
      "type": "integer"
    },
    "episodeId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Episodeid",
      "type": "string"
    },
    "episodeTitle": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Episodetitle",
      "type": "string"
    },
    "instruction": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "novelId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Novelid",
      "type": "string"
    },
    "operation": {
      "enum": [
        "episode_storyboard_generate",
        "episode_storyboard_revise"
      ],
      "title": "Operation",
      "type": "string"
    },
    "productionDefaults": {
      "$ref": "#/$defs/VideoStoryboardProductionDefaults"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Projectid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "video-episode-storyboard-context/1.0",
      "default": "video-episode-storyboard-context/1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "script": {
      "$ref": "#/$defs/VideoEpisodeScriptDocument"
    },
    "scriptContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scriptcontenthash",
      "type": "string"
    },
    "scriptVersionId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Scriptversionid",
      "type": "string"
    },
    "selectedShotIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 300,
      "title": "Selectedshotids",
      "type": "array"
    },
    "stableShotIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 300,
      "title": "Stableshotids",
      "type": "array"
    }
  },
  "required": [
    "episodeId",
    "projectId",
    "novelId",
    "episodeTitle",
    "operation",
    "draftRevision",
    "draftContentHash",
    "scriptVersionId",
    "scriptContentHash",
    "baseStoryboardVersionId",
    "script",
    "draft",
