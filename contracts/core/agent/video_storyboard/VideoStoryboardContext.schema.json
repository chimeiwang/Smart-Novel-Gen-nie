          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "outputFormat": {
          "const": "mp4",
          "default": "mp4",
          "title": "Outputformat",
          "type": "string"
        },
        "prompt": {
          "maxLength": 2500,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "provider": {
          "const": "seedance",
          "default": "seedance",
          "title": "Provider",
          "type": "string"
        },
        "ratio": {
          "enum": [
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16",
            "21:9",
            "adaptive"
          ],
          "title": "Ratio",
          "type": "string"
