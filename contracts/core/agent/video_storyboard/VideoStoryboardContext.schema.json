    "VideoStoryboardProductionDefaults": {
      "additionalProperties": false,
      "description": "AI 候选固定为模拟制作输入，不能代表用户确认真实供应商费用。",
      "properties": {
        "executionMode": {
          "const": "simulated",
          "default": "simulated",
          "title": "Executionmode",
          "type": "string"
        },
        "feeConfirmed": {
          "const": false,
          "default": false,
          "title": "Feeconfirmed",
          "type": "boolean"
        },
        "generateAudio": {
          "default": true,
          "title": "Generateaudio",
          "type": "boolean"
        },
        "generationMode": {
          "const": "reference",
          "default": "reference",
          "title": "Generationmode",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "outputFormat": {
          "const": "mp4",
          "default": "mp4",
          "title": "Outputformat",
          "type": "string"
        },
        "provider": {
          "const": "seedance",
          "default": "seedance",
          "title": "Provider",
          "type": "string"
        },
        "ratio": {
          "enum": [
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16",
            "21:9",
            "adaptive"
          ],
          "title": "Ratio",
          "type": "string"
        },
        "resolution": {
          "const": "720p",
          "default": "720p",
          "title": "Resolution",
          "type": "string"
        },
        "watermark": {
          "default": false,
          "title": "Watermark",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "ratio"
      ],
      "title": "VideoStoryboardProductionDefaults",
      "type": "object"
    },
    "VideoStoryboardProductionIntent": {
      "additionalProperties": false,
      "properties": {
        "durationSeconds": {
          "maximum": 12,
          "minimum": 4,
          "title": "Durationseconds",
          "type": "integer"
        },
        "executionMode": {
          "const": "simulated",
          "default": "simulated",
          "title": "Executionmode",
          "type": "string"
