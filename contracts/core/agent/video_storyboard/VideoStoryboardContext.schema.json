      "type": "object"
    },
    "VideoStoryboardReferenceEvidence": {
      "additionalProperties": false,
      "description": "Core 冻结的已批准视觉版本与已核验图片事实。",
      "properties": {
        "assetId": {
          "maxLength": 128,
          "minLength": 1,
