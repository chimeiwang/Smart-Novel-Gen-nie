  "required": [
    "role",
    "motivatedBy",
    "direction",
    "azimuthDegrees",
    "elevationDegrees",
    "quality",
    "delivery",
    "colorTemperatureK",
    "relativeExposureStops",
    "beamAngleDegrees",
    "falloff",
    "spillControl",
    "visibleResult"
