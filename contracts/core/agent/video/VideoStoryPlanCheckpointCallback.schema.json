        },
        "beatId": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Beatid",
          "type": "string"
        },
        "blocking": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Blocking",
          "type": "string"
        },
        "dramaticPurpose": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Dramaticpurpose",
          "type": "string"
        },
        "endSecond": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Endsecond",
          "type": "integer"
        },
        "performanceDirection": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Performancedirection",
