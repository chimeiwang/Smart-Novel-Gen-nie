          "maxItems": 12,
          "minItems": 1,
          "title": "Includefeatures",
          "type": "array"
        },
        "keyframeRole": {
          "anyOf": [
            {
              "enum": [
                "initial_state",
                "end_state",
                "transition_anchor"
              ],
              "type": "string"
