            "$ref": "#/$defs/StoryBeatPlanArguments"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "dramaticArc": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Dramaticarc",
          "type": "string"
        },
        "globalDirection": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Globaldirection",
          "type": "string"
        },
        "negativeConstraints": {
          "items": {
            "type": "string"
          },
          "maxItems": 18,
          "minItems": 1,
          "title": "Negativeconstraints",
          "type": "array"
