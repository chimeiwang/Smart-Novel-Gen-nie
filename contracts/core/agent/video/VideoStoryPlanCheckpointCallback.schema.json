        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visualStyle": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Visualstyle",
          "type": "string"
        }
