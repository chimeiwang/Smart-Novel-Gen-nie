    "SceneAssetsStageArguments": {
      "additionalProperties": false,
      "description": "场景与素材阶段完成本地归一化后的耐久规范。",
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/PlannedAssetArguments"
