        "reservedCalls": {
          "maximum": 5,
          "minimum": 0,
          "title": "Reservedcalls",
          "type": "integer"
        }
      },
      "required": [
        "reservedCalls",
        "pendingStage"
      ],
      "title": "VideoPlanAttemptState",
      "type": "object"
    }
