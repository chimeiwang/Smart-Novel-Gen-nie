          "type": "string"
        },
        "bindingScope": {
          "enum": [
            "canon_slot",
            "scene_direct"
          ],
          "title": "Bindingscope",
          "type": "string"
        },
        "duty": {
          "enum": [
            "identity",
            "costume",
            "scene",
            "prop",
            "style",
            "storyboard",
            "keyframe",
            "motion",
            "camera",
            "voice",
            "ambience",
            "relation_interaction"
          ],
          "title": "Duty",
          "type": "string"
        },
        "excludeFeatures": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Excludefeatures",
          "type": "array"
        },
        "featureDomain": {
          "enum": [
            "character_identity",
            "character_costume",
            "location",
            "prop",
            "style",
            "storyboard",
            "keyframe",
            "motion",
            "camera",
            "voice",
            "ambience",
            "music",
            "relationship_interaction"
          ],
          "title": "Featuredomain",
          "type": "string"
        },
        "includeFeatures": {
          "items": {
            "type": "string"
