      "title": "PlannedAssetArguments",
      "type": "object"
    },
    "SettingReference": {
      "additionalProperties": false,
      "description": "指向长篇冻结设定快照中的一个类型化条目。",
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "relationship",
            "location",
            "item",
            "world_setting"
