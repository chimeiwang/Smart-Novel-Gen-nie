        "keyframeRole": {
          "anyOf": [
            {
              "enum": [
                "initial_state",
                "end_state",
                "transition_anchor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyframerole"
        },
        "modality": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "title": "Modality",
          "type": "string"
        },
        "settingReference": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettingReference"
            },
            {
              "type": "null"
            }
