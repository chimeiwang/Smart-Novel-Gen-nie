          "enum": [
            "continuous",
            "cut",
            "match_cut",
            "impact_cut"
          ],
          "title": "Changemode",
          "type": "string"
        },
        "endShotSize": {
          "enum": [
            "大全景",
            "全景",
            "中景",
            "近景",
            "特写"
          ],
          "title": "Endshotsize",
          "type": "string"
        },
        "startShotSize": {
          "enum": [
            "大全景",
            "全景",
            "中景",
            "近景",
            "特写"
          ],
          "title": "Startshotsize",
          "type": "string"
        }
      },
      "required": [
        "startShotSize",
        "endShotSize",
