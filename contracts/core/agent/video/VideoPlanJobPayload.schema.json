          "type": "string"
        },
        "azimuthDegrees": {
          "maximum": 180,
          "minimum": -180,
          "title": "Azimuthdegrees",
          "type": "integer"
        },
        "elevationDegrees": {
          "maximum": 90,
          "minimum": -90,
          "title": "Elevationdegrees",
          "type": "integer"
        },
        "heightCm": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Heightcm",
          "type": "integer"
        },
        "rollDegrees": {
          "maximum": 45,
          "minimum": -45,
          "title": "Rolldegrees",
          "type": "integer"
        },
        "subjectDistanceMeters": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Subjectdistancemeters",
          "type": "number"
        }
      },
      "required": [
        "heightCm",
        "azimuthDegrees",
        "elevationDegrees",
        "rollDegrees",
        "subjectDistanceMeters",
        "axisSide"
      ],
      "title": "CameraPositionSpec",
      "type": "object"
    },
    "CameraShotProgression": {
      "additionalProperties": false,
