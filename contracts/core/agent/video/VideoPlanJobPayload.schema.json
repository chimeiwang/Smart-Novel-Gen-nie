{
  "$defs": {
    "AssetBinding": {
      "additionalProperties": false,
      "description": "编译阶段的素材绑定；fixture 明确表示它仍是待补齐素材。",
      "properties": {
        "assetId": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Assetid",
          "type": "string"
        },
        "bindingScope": {
          "default": "scene_direct",
          "enum": [
            "canon_slot",
            "scene_direct"
          ],
          "title": "Bindingscope",
          "type": "string"
        },
        "duty": {
          "enum": [
            "identity",
            "costume",
            "scene",
            "prop",
            "style",
            "storyboard",
            "keyframe",
            "motion",
            "camera",
            "voice",
            "ambience",
            "music",
            "relation_interaction"
          ],
          "title": "Duty",
          "type": "string"
        },
        "excludeFeatures": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Excludefeatures",
          "type": "array"
        },
        "featureDomain": {
          "anyOf": [
            {
              "enum": [
                "character_identity",
                "character_costume",
                "location",
                "prop",
                "style",
                "storyboard",
                "keyframe",
                "motion",
                "camera",
                "voice",
                "ambience",
                "music",
                "relationship_interaction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Featuredomain"
        },
        "includeFeatures": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Includefeatures",
          "type": "array"
        },
        "isFixture": {
          "default": true,
          "title": "Isfixture",
          "type": "boolean"
        },
        "keyframeRole": {
          "anyOf": [
            {
              "enum": [
                "initial_state",
                "end_state",
                "transition_anchor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyframerole"
        },
        "mediaAssetId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mediaassetid"
        },
        "modality": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "title": "Modality",
          "type": "string"
        },
        "settingReference": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettingReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targetEntity": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Targetentity",
          "type": "string"
        }
      },
      "required": [
        "assetId",
        "modality",
        "duty",
        "targetEntity",
        "includeFeatures",
        "excludeFeatures"
      ],
      "title": "AssetBinding",
      "type": "object"
    },
    "CameraActionUnit": {
      "additionalProperties": false,
      "description": "一个主体动作及其唯一可见结果。",
      "properties": {
        "action": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "subject": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "visibleResult": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Visibleresult",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "action",
        "visibleResult"
      ],
      "title": "CameraActionUnit",
      "type": "object"
    },
    "CameraBeatSpec": {
      "additionalProperties": false,
      "description": "整数秒、单一主运镜的连续镜头节拍。",
      "properties": {
        "action": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "actionComplexity": {
          "default": "legacy_unclassified",
          "enum": [
            "legacy_unclassified",
            "simple",
            "mechanical_sequence",
            "transformation",
            "impact_transition"
          ],
          "title": "Actioncomplexity",
          "type": "string"
        },
        "actionUnits": {
          "items": {
            "$ref": "#/$defs/CameraActionUnit"
          },
          "maxItems": 3,
          "title": "Actionunits",
          "type": "array"
        },
        "axisTransition": {
          "anyOf": [
            {
              "enum": [
                "hold",
                "continuous_cross",
                "neutral_reset",
                "cutaway_reset"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Axistransition"
        },
        "beatId": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Beatid",
          "type": "string"
        },
        "blocking": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocking"
        },
        "cameraAngle": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cameraangle",
          "type": "string"
        },
        "cameraMotivation": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cameramotivation"
        },
        "cameraMovement": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Cameramovement",
          "type": "string"
        },
        "cameraSpec": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotCameraSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dramaticPurpose": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dramaticpurpose"
        },
        "endSecond": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Endsecond",
          "type": "integer"
        },
        "lightingCue": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotLightingCue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "performanceDirection": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Performancedirection"
        },
        "referencedAssetIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Referencedassetids",
          "type": "array"
        },
        "shotProgression": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraShotProgression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shotSize": {
          "enum": [
            "大全景",
            "全景",
            "中景",
            "近景",
            "特写"
          ],
          "title": "Shotsize",
          "type": "string"
        },
        "sound": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sound"
        },
        "startSecond": {
          "maximum": 29,
          "minimum": 0,
          "title": "Startsecond",
          "type": "integer"
        },
        "transition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transition"
        }
      },
      "required": [
        "beatId",
        "startSecond",
        "endSecond",
        "shotSize",
        "cameraAngle",
        "cameraMovement",
        "action"
      ],
      "title": "CameraBeatSpec",
      "type": "object"
    },
    "CameraCompositionSpec": {
      "additionalProperties": false,
      "description": "镜头构图和画面层次。",
      "properties": {
        "backgroundLayer": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Backgroundlayer",
          "type": "string"
        },
        "foregroundLayer": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Foregroundlayer",
          "type": "string"
        },
        "headroom": {
          "enum": [
            "tight",
            "standard",
            "generous",
            "not_applicable"
          ],
          "title": "Headroom",
          "type": "string"
        },
        "rule": {
          "enum": [
            "centered",
            "rule_of_thirds",
            "symmetrical",
            "leading_lines",
            "frame_within_frame",
            "negative_space"
          ],
          "title": "Rule",
          "type": "string"
        },
        "subjectFramePercent": {
          "maximum": 100,
          "minimum": 5,
          "title": "Subjectframepercent",
          "type": "integer"
        },
        "subjectPlacement": {
          "enum": [
            "left_third",
            "center",
            "right_third",
            "lower_center",
            "upper_center"
          ],
          "title": "Subjectplacement",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "subjectPlacement",
        "subjectFramePercent",
        "headroom",
        "foregroundLayer",
        "backgroundLayer"
      ],
      "title": "CameraCompositionSpec",
      "type": "object"
    },
    "CameraFocusSpec": {
      "additionalProperties": false,
      "description": "景深和焦点迁移计划。",
      "properties": {
        "depthOfField": {
          "enum": [
            "shallow",
            "medium",
            "deep"
          ],
          "title": "Depthoffield",
          "type": "string"
        },
        "endTarget": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Endtarget",
          "type": "string"
        },
        "rackDurationSeconds": {
          "maximum": 30,
          "minimum": 0,
          "title": "Rackdurationseconds",
          "type": "number"
        },
        "startTarget": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Starttarget",
          "type": "string"
        },
        "transition": {
          "enum": [
            "locked",
            "rack_focus"
          ],
          "title": "Transition",
          "type": "string"
        }
      },
      "required": [
        "depthOfField",
        "startTarget",
        "endTarget",
        "transition",
        "rackDurationSeconds"
      ],
      "title": "CameraFocusSpec",
      "type": "object"
    },
    "CameraMovementSpec": {
      "additionalProperties": false,
      "description": "单一主运镜；位移与旋转量用于本地可执行性校验。",
      "properties": {
        "easing": {
          "enum": [
            "none",
            "ease_in",
            "ease_out",
            "ease_in_out"
          ],
          "title": "Easing",
          "type": "string"
        },
        "movementType": {
          "enum": [
            "locked_off",
            "dolly_in",
            "dolly_out",
            "truck_left",
            "truck_right",
            "pan_left",
            "pan_right",
            "tilt_up",
            "tilt_down",
            "pedestal_up",
            "pedestal_down",
            "arc_left",
            "arc_right",
            "boom_up",
            "boom_down",
            "zoom_in",
            "zoom_out",
            "handheld_follow"
          ],
          "title": "Movementtype",
          "type": "string"
        },
        "rotationDegrees": {
          "maximum": 360,
          "minimum": 0,
          "title": "Rotationdegrees",
          "type": "number"
        },
        "speed": {
          "enum": [
            "static",
            "very_slow",
            "slow",
            "medium",
            "fast"
          ],
          "title": "Speed",
          "type": "string"
        },
        "support": {
          "enum": [
            "tripod",
            "slider",
            "dolly",
            "gimbal",
            "steadicam",
            "handheld",
            "shoulder",
            "jib",
            "crane"
          ],
          "title": "Support",
          "type": "string"
        },
        "travelDistanceMeters": {
          "maximum": 50,
          "minimum": 0,
          "title": "Traveldistancemeters",
          "type": "number"
        }
      },
      "required": [
        "support",
        "movementType",
        "travelDistanceMeters",
        "rotationDegrees",
        "speed",
        "easing"
      ],
      "title": "CameraMovementSpec",
      "type": "object"
    },
    "CameraPositionSpec": {
      "additionalProperties": false,
      "description": "相对主体的可复核机位，不把“低机位”等模糊词当成唯一事实。",
