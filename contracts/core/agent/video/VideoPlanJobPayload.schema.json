          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "contentHash",
        "name"
      ],
      "title": "CharacterSettingSnapshot",
      "type": "object"
    },
