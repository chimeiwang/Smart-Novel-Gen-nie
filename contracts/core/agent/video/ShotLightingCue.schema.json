  "$id": "https://inkforge.local/contracts/agent/video/ShotLightingCue/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "逐拍灯光：主光必填，边缘/背景/实景光按需启用。",
  "properties": {
    "atmosphere": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Atmosphere",
      "type": "string"
    },
    "continuityMode": {
      "enum": [
        "establish",
        "inherit",
        "motivated_change"
      ],
      "title": "Continuitymode",
      "type": "string"
    },
    "edgeLight": {
      "anyOf": [
        {
          "$ref": "#/$defs/LightSourceSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fillDirection": {
      "anyOf": [
        {
          "enum": [
            "front",
            "front_left",
            "front_right",
            "side_left",
            "side_right",
            "back_left",
            "back_right",
            "back",
            "top",
            "bottom"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Filldirection"
    },
    "fillRelativeStops": {
      "maximum": 8,
      "minimum": -8,
      "title": "Fillrelativestops",
      "type": "number"
    },
    "fillStrategy": {
      "enum": [
        "none",
        "soft_fill",
        "bounce_fill",
        "negative_fill"
      ],
      "title": "Fillstrategy",
      "type": "string"
