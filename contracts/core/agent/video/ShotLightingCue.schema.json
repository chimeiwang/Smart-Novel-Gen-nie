          "enum": [
            "key",
            "fill",
            "rim",
            "background",
            "practical"
          ],
          "title": "Role",
          "type": "string"
        },
        "spillControl": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Spillcontrol",
          "type": "string"
        },
        "visibleResult": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Visibleresult",
          "type": "string"
        }
