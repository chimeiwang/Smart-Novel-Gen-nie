    "keyLight": {
      "$ref": "#/$defs/LightSourceSpec"
    },
    "motivatedChange": {
      "maxLength": 160,
      "title": "Motivatedchange",
      "type": "string"
    },
    "visibleResult": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Visibleresult",
      "type": "string"
    }
  },
  "required": [
    "continuityMode",
    "motivatedChange",
    "keyLight",
    "fillStrategy",
    "fillDirection",
    "fillRelativeStops",
    "atmosphere",
    "visibleResult"
