{
  "$defs": {
    "CompiledAssetBinding": {
      "additionalProperties": false,
      "description": "本次供应商请求中的局部素材编号映射。",
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "assetId": {
          "title": "Assetid",
          "type": "string"
        },
        "bindingScope": {
          "enum": [
            "canon_slot",
            "scene_direct"
          ],
          "title": "Bindingscope",
          "type": "string"
        },
        "duty": {
          "enum": [
            "identity",
            "costume",
            "scene",
            "prop",
            "style",
            "storyboard",
            "keyframe",
            "motion",
            "camera",
            "voice",
            "ambience",
            "music",
            "relation_interaction"
          ],
          "title": "Duty",
          "type": "string"
        },
        "featureDomain": {
          "anyOf": [
            {
              "enum": [
                "character_identity",
                "character_costume",
                "location",
                "prop",
                "style",
                "storyboard",
                "keyframe",
                "motion",
                "camera",
                "voice",
                "ambience",
                "music",
                "relationship_interaction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Featuredomain"
        },
        "isFixture": {
          "title": "Isfixture",
          "type": "boolean"
        },
        "keyframeRole": {
          "anyOf": [
            {
              "enum": [
                "initial_state",
                "end_state",
                "transition_anchor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyframerole"
        },
        "mediaAssetId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mediaassetid"
        },
        "modality": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "title": "Modality",
          "type": "string"
        },
        "settingReference": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettingReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetEntity": {
          "title": "Targetentity",
          "type": "string"
        }
      },
      "required": [
        "assetId",
        "mediaAssetId",
        "alias",
        "modality",
        "duty",
        "bindingScope",
        "settingReference",
        "targetEntity",
        "isFixture"
      ],
      "title": "CompiledAssetBinding",
      "type": "object"
    },
    "SeedanceOutputSpec": {
      "additionalProperties": false,
      "description": "当前已由火山方舟公开文档确认的 Seedance 2.5 输出参数。",
      "properties": {
        "durationSeconds": {
          "maximum": 30,
          "minimum": 4,
          "title": "Durationseconds",
          "type": "integer"
        },
        "generateAudio": {
          "default": true,
          "title": "Generateaudio",
          "type": "boolean"
        },
        "model": {
          "const": "doubao-seedance-2-5-260628",
          "default": "doubao-seedance-2-5-260628",
          "title": "Model",
          "type": "string"
        },
        "outputFormat": {
          "default": "mp4",
          "enum": [
            "mp4",
            "mov"
          ],
          "title": "Outputformat",
          "type": "string"
        },
        "ratio": {
          "default": "16:9",
          "enum": [
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16",
            "21:9",
            "adaptive"
          ],
          "title": "Ratio",
          "type": "string"
        },
        "resolution": {
          "default": "720p",
          "enum": [
            "480p",
            "720p"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "watermark": {
          "default": false,
          "title": "Watermark",
          "type": "boolean"
        }
      },
      "required": [
        "durationSeconds"
      ],
      "title": "SeedanceOutputSpec",
      "type": "object"
    },
    "SettingReference": {
      "additionalProperties": false,
      "description": "指向长篇冻结设定快照中的一个类型化条目。",
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "relationship",
            "location",
            "item",
            "world_setting"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "SettingReference",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/video/SeedancePromptPackage/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "可展示、可审核，并区分官方建议长度与产品安全上限。",
  "properties": {
    "assetBindings": {
      "items": {
        "$ref": "#/$defs/CompiledAssetBinding"
      },
      "title": "Assetbindings",
      "type": "array"
    },
    "assetReady": {
      "title": "Assetready",
      "type": "boolean"
    },
    "compileProfile": {
      "default": "legacy_single_prompt_v1",
      "enum": [
        "legacy_single_prompt_v1",
        "dual_layer_v1",
        "seedance_cinematic_v2",
        "seedance_director_v3",
        "seedance_director_v3_compat"
      ],
      "title": "Compileprofile",
      "type": "string"
    },
    "fixtureOnly": {
      "title": "Fixtureonly",
      "type": "boolean"
    },
    "manifestPrompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifestprompt"
    },
    "manifestPromptCharacterCount": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifestpromptcharactercount"
    },
    "maxPromptCharacters": {
      "default": 2000,
      "maximum": 6000,
      "minimum": 1,
      "title": "Maxpromptcharacters",
      "type": "integer"
    },
    "output": {
      "$ref": "#/$defs/SeedanceOutputSpec"
    },
    "previewOnly": {
      "title": "Previewonly",
      "type": "boolean"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "promptCharacterCount": {
      "maximum": 6000,
      "minimum": 1,
      "title": "Promptcharactercount",
      "type": "integer"
    },
    "providerPrompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providerprompt"
    },
    "providerPromptCharacterCount": {
      "anyOf": [
        {
          "maximum": 6000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providerpromptcharactercount"
    },
    "recommendedPromptCharacters": {
      "default": 500,
      "maximum": 6000,
      "minimum": 1,
      "title": "Recommendedpromptcharacters",
      "type": "integer"
    },
    "sceneId": {
      "title": "Sceneid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "submissionReady": {
      "title": "Submissionready",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "sceneId",
    "prompt",
    "promptCharacterCount",
    "assetBindings",
    "output",
    "previewOnly",
    "assetReady",
    "submissionReady",
    "fixtureOnly"
  ],
  "title": "SeedancePromptPackage",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video.SeedancePromptPackage"
}
