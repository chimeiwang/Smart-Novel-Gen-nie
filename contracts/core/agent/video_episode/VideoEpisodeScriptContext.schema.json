{
  "$defs": {
    "VideoEpisodeCharacterEvidence": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 20000,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "VideoEpisodeCharacterEvidence",
      "type": "object"
    },
    "VideoEpisodeDependencyEvidence": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "episodeId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Episodeid",
          "type": "string"
        },
        "scriptVersionId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Scriptversionid",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/VideoEpisodeEndingState"
        }
      },
      "required": [
        "episodeId",
        "scriptVersionId",
        "state",
        "contentHash"
      ],
      "title": "VideoEpisodeDependencyEvidence",
      "type": "object"
    },
    "VideoEpisodeDependencyInput": {
      "additionalProperties": false,
      "properties": {
        "consumerLineId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumerlineid"
        },
        "consumerSceneId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Consumersceneid",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "narrativeTime": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Narrativetime",
          "type": "string"
        },
        "producerEpisodeId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producerepisodeid",
          "type": "string"
        },
        "producerScriptVersionId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producerscriptversionid",
          "type": "string"
        },
        "producerStateKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Producerstatekey",
          "type": "string"
        }
      },
      "required": [
        "producerEpisodeId",
        "producerScriptVersionId",
        "producerStateKey",
        "consumerSceneId",
        "narrativeTime",
        "description"
      ],
      "title": "VideoEpisodeDependencyInput",
      "type": "object"
    },
    "VideoEpisodeEndingState": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "entityIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Entityids",
          "type": "array"
        },
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Key",
          "type": "string"
        },
        "narrativeTime": {
          "default": "",
          "maxLength": 400,
          "title": "Narrativetime",
          "type": "string"
        }
      },
      "required": [
        "key",
        "description"
      ],
      "title": "VideoEpisodeEndingState",
      "type": "object"
    },
    "VideoEpisodeScriptDocument": {
      "additionalProperties": false,
      "description": "工作稿和正式版共用完整结构；空工作稿不冒充已经确认的剧本。",
      "properties": {
        "dependencies": {
          "items": {
            "$ref": "#/$defs/VideoEpisodeDependencyInput"
          },
          "maxItems": 200,
          "title": "Dependencies",
          "type": "array"
        },
        "endingStates": {
          "items": {
            "$ref": "#/$defs/VideoEpisodeEndingState"
          },
          "maxItems": 100,
          "title": "Endingstates",
          "type": "array"
        },
        "overview": {
          "$ref": "#/$defs/VideoEpisodeScriptOverview"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/VideoEpisodeScriptScene"
          },
          "maxItems": 60,
          "title": "Scenes",
          "type": "array"
        },
        "schemaVersion": {
          "const": "video-episode-script/1.0",
          "default": "video-episode-script/1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "title": "VideoEpisodeScriptDocument",
      "type": "object"
    },
    "VideoEpisodeScriptLine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "kind": {
          "enum": [
            "action",
            "dialogue",
            "narration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sourceRefs": {
          "items": {
            "$ref": "#/$defs/VideoEpisodeSourceRef"
          },
          "maxItems": 40,
          "title": "Sourcerefs",
          "type": "array"
        },
        "speakerId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speakerid"
        },
        "tempKey": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tempkey"
        },
        "text": {
          "maxLength": 8000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "VideoEpisodeScriptLine",
      "type": "object"
    },
    "VideoEpisodeScriptOverview": {
      "additionalProperties": false,
      "properties": {
        "creativeIntent": {
          "default": "",
          "maxLength": 4000,
          "title": "Creativeintent",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "targetDurationSeconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetdurationseconds"
        }
      },
      "title": "VideoEpisodeScriptOverview",
      "type": "object"
    },
    "VideoEpisodeScriptScene": {
      "additionalProperties": false,
      "properties": {
        "characterIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Characterids",
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/VideoEpisodeScriptLine"
          },
          "maxItems": 500,
          "title": "Lines",
          "type": "array"
        },
        "locationLabel": {
          "maxLength": 240,
          "title": "Locationlabel",
          "type": "string"
        },
        "narrativeTime": {
          "maxLength": 400,
          "title": "Narrativetime",
          "type": "string"
        },
        "tempKey": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tempkey"
        },
        "timeLabel": {
          "maxLength": 160,
          "title": "Timelabel",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "locationLabel",
        "timeLabel",
        "narrativeTime"
      ],
      "title": "VideoEpisodeScriptScene",
      "type": "object"
    },
    "VideoEpisodeSelectedSourceEvidence": {
      "additionalProperties": false,
      "description": "只把明确选中的片段交给模型；偏移仍引用完整不可变章节快照。",
      "properties": {
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "sourceSnapshotId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourcesnapshotid",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "textHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Texthash",
          "type": "string"
        }
      },
      "required": [
        "sourceSnapshotId",
        "start",
        "end",
        "text",
        "textHash"
      ],
      "title": "VideoEpisodeSelectedSourceEvidence",
      "type": "object"
    },
    "VideoEpisodeSourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "chapterId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Chapterid",
          "type": "string"
        },
        "chapterTitle": {
          "maxLength": 240,
          "title": "Chaptertitle",
          "type": "string"
        },
        "selectedRanges": {
          "items": {
            "$ref": "#/$defs/VideoEpisodeSelectedSourceEvidence"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Selectedranges",
          "type": "array"
        },
        "sourceHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcehash",
          "type": "string"
        },
        "sourceSnapshotId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourcesnapshotid",
          "type": "string"
        }
      },
      "required": [
        "sourceSnapshotId",
        "chapterId",
        "chapterTitle",
        "sourceHash",
        "selectedRanges"
      ],
      "title": "VideoEpisodeSourceEvidence",
      "type": "object"
    },
    "VideoEpisodeSourceRef": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "sourceSnapshotId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourcesnapshotid",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "sourceSnapshotId",
        "start",
        "end"
      ],
      "title": "VideoEpisodeSourceRef",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/video_episode/VideoEpisodeScriptContext/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "模型只读取 Core 已冻结的完整输入，不查询当前章节或工作稿。",
  "properties": {
    "baseScriptVersionId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Basescriptversionid"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/VideoEpisodeCharacterEvidence"
      },
      "maxItems": 200,
      "title": "Characters",
      "type": "array"
    },
    "draft": {
      "$ref": "#/$defs/VideoEpisodeScriptDocument"
    },
    "draftRevision": {
      "minimum": 1,
      "title": "Draftrevision",
      "type": "integer"
    },
    "episodeId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Episodeid",
      "type": "string"
    },
    "episodeTitle": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Episodetitle",
      "type": "string"
    },
    "inheritedStates": {
      "items": {
        "$ref": "#/$defs/VideoEpisodeDependencyEvidence"
      },
      "maxItems": 200,
      "title": "Inheritedstates",
      "type": "array"
    },
    "instruction": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "novelId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Novelid",
      "type": "string"
    },
    "operation": {
      "enum": [
        "episode_script_generate",
        "episode_script_revise"
      ],
      "title": "Operation",
      "type": "string"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Projectid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "video-episode-script-context/1.0",
      "default": "video-episode-script-context/1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "selectedSceneIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 60,
      "title": "Selectedsceneids",
      "type": "array"
    },
    "sourceSetVersionId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sourcesetversionid"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/VideoEpisodeSourceEvidence"
      },
      "maxItems": 40,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "episodeId",
    "projectId",
    "novelId",
    "episodeTitle",
    "operation",
    "draftRevision",
    "sourceSetVersionId",
    "baseScriptVersionId",
    "draft",
    "sources",
    "characters",
    "inheritedStates",
    "selectedSceneIds",
    "instruction"
  ],
  "title": "VideoEpisodeScriptContext",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video_episode.VideoEpisodeScriptContext"
}
