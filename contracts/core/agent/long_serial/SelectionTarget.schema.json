{
  "$id": "https://inkforge.local/contracts/agent/long_serial/SelectionTarget/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "客户端提交的不可变选区身份；正文由 Core 从权威源派生。",
  "properties": {
    "baseContentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Basecontenthash",
      "type": "string"
    },
    "baseUpdatedAt": {
      "format": "date-time",
      "title": "Baseupdatedat",
      "type": "string"
    },
    "resourceId": {
      "minLength": 1,
      "title": "Resourceid",
      "type": "string"
    },
    "resourceType": {
      "enum": [
        "chapter_content",
        "outline_content",
        "outline_node_content"
      ],
      "title": "Resourcetype",
      "type": "string"
    },
    "selectedTextHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selectedtexthash",
      "type": "string"
    },
    "selectionEnd": {
      "minimum": 0,
      "title": "Selectionend",
      "type": "integer"
    },
    "selectionStart": {
      "minimum": 0,
      "title": "Selectionstart",
      "type": "integer"
    }
  },
  "required": [
    "resourceType",
    "resourceId",
    "baseUpdatedAt",
    "baseContentHash",
    "selectionStart",
    "selectionEnd",
    "selectedTextHash"
  ],
  "title": "SelectionTarget",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.long_serial.SelectionTarget"
}
