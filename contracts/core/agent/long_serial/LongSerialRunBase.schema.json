  "$id": "https://inkforge.local/contracts/agent/long_serial/LongSerialRunBase/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chapterId": {
      "minLength": 1,
      "title": "Chapterid",
      "type": "string"
    },
    "operation": {
      "enum": [
        "answer_question",
        "create_lore",
        "revise_lore",
        "create_outline",
        "revise_outline",
        "plan_chapter",
        "write_chapter",
        "rewrite_scene",
        "rewrite_chapter_selection",
        "rewrite_outline_selection",
        "review_chapter",
        "manage_foreshadowing"
      ],
      "title": "Operation",
      "type": "string"
    },
    "scope": {
      "discriminator": {
        "mapping": {
          "chapter": "#/$defs/ChapterScope",
          "chapter_range": "#/$defs/ChapterRangeScope",
          "novel": "#/$defs/NovelScope",
          "outline_node": "#/$defs/OutlineNodeScope"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChapterScope"
        },
        {
          "$ref": "#/$defs/ChapterRangeScope"
        },
        {
          "$ref": "#/$defs/OutlineNodeScope"
        },
        {
          "$ref": "#/$defs/NovelScope"
        }
      ],
      "title": "Scope"
    },
    "selectionSnapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectionSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selectionTarget": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectionTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sourceBindings": {
      "items": {
        "$ref": "#/$defs/SourceBinding"
      },
      "minItems": 1,
      "title": "Sourcebindings",
      "type": "array"
    },
    "target": {
      "$ref": "#/$defs/ChapterTarget"
    },
    "targetWordCount": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Targetwordcount",
      "type": "integer"
    },
    "userInstruction": {
      "minLength": 1,
      "title": "Userinstruction",
      "type": "string"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "workflow": {
      "const": "long_serial",
      "title": "Workflow",
      "type": "string"
    },
    "writingSessionId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Writingsessionid"
    }
  },
  "required": [
    "version",
    "workflow",
    "chapterId",
    "writingSessionId",
    "operation",
    "target",
    "scope",
    "sourceBindings",
    "targetWordCount",
    "userInstruction"
  ],
  "title": "LongSerialRunBase",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.long_serial.LongSerialRunBase"
}
