{
  "$id": "https://inkforge.local/contracts/agent/quality_execution/QualityStepInput/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failedResultHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failedresulthash"
    },
    "failedStepId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failedstepid"
    },
    "failureCode": {
      "anyOf": [
        {
          "const": "MODEL_TOOL_PROTOCOL_CORRECTION_REQUIRED",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failurecode"
    },
    "userInstruction": {
      "minLength": 1,
      "title": "Userinstruction",
      "type": "string"
    }
  },
  "required": [
    "userInstruction"
  ],
  "title": "QualityStepInput",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.quality_execution.QualityStepInput"
}
