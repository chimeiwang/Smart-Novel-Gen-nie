        "coverageGoals": {
          "items": {
            "$ref": "#/$defs/BeatCoverageGoal"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Coveragegoals",
          "type": "array"
        },
        "dramaticTurn": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Dramaticturn",
          "type": "string"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/CinematicShotCandidate"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Shots",
          "type": "array"
        },
        "sourceRanges": {
          "items": {
            "$ref": "#/$defs/ChapterAdaptationSourceRange"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Sourceranges",
          "type": "array"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visualStrategy": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Visualstrategy",
          "type": "string"
        }
      },
      "required": [
        "beatKey",
        "title",
        "dramaticTurn",
        "visualStrategy",
        "coverageGoals",
        "sourceRanges",
        "shots"
      ],
      "title": "DramaticBeatCandidate",
      "type": "object"
    },
