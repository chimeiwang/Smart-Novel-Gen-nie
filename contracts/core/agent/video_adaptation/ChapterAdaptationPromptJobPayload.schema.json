    "LongSerialSettingSnapshot": {
      "additionalProperties": false,
      "description": "Core 冻结后随长篇视频任务发送的完整设定投影。",
      "properties": {
        "entries": {
          "items": {
            "discriminator": {
              "mapping": {
                "character": "#/$defs/CharacterSettingSnapshot",
                "item": "#/$defs/ItemSettingSnapshot",
                "location": "#/$defs/LocationSettingSnapshot",
                "relationship": "#/$defs/RelationshipSettingSnapshot",
                "world_setting": "#/$defs/WorldSettingSnapshot"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CharacterSettingSnapshot"
              },
              {
                "$ref": "#/$defs/RelationshipSettingSnapshot"
              },
              {
                "$ref": "#/$defs/LocationSettingSnapshot"
              },
              {
                "$ref": "#/$defs/ItemSettingSnapshot"
              },
              {
                "$ref": "#/$defs/WorldSettingSnapshot"
              }
            ]
          },
          "title": "Entries",
          "type": "array"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "entries"
      ],
      "title": "LongSerialSettingSnapshot",
      "type": "object"
    },
