{
  "$defs": {
    "BeatCoverageGoal": {
      "additionalProperties": false,
      "description": "一个节拍希望观众获得的内容，不预设必须使用哪类镜头完成。",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "goalKey": {
          "pattern": "^G[0-9]{2,3}$",
          "title": "Goalkey",
          "type": "string"
        },
        "kind": {
          "enum": [
            "story_information",
            "action",
            "emotion",
            "space",
            "relationship",
            "motif",
            "transition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "priority": {
          "enum": [
            "essential",
            "supporting"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "goalKey",
        "kind",
        "priority",
        "description"
      ],
      "title": "BeatCoverageGoal",
      "type": "object"
    },
    "ChapterAdaptationPlanCandidate": {
      "additionalProperties": false,
      "description": "进入 ReviewArtifact 的完整 Scene → Beat → Shot 候选。",
      "properties": {
        "adaptationId": {
          "minLength": 1,
          "title": "Adaptationid",
          "type": "string"
        },
        "reviewFindings": {
          "items": {
            "$ref": "#/$defs/CinematicReviewFinding"
          },
          "maxItems": 480,
          "title": "Reviewfindings",
          "type": "array"
        },
        "reviewSummary": {
          "anyOf": [
            {
              "maxLength": 1200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewsummary"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/CinematicSceneCandidate"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "schemaVersion": {
          "const": "chapter_adaptation_plan_v3",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourceHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcehash",
          "type": "string"
        },
        "suggestedEpisodeBreakAfterShotKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 119,
          "title": "Suggestedepisodebreakaftershotkeys",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "adaptationId",
        "sourceHash",
        "scenes"
      ],
      "title": "ChapterAdaptationPlanCandidate",
      "type": "object"
    },
    "ChapterAdaptationSourceRange": {
      "additionalProperties": false,
      "description": "相对于不可变章节全文的 Unicode code point 左闭右开范围。",
      "properties": {
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "sourceText": {
          "maxLength": 120000,
          "minLength": 1,
          "title": "Sourcetext",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "sourceText"
      ],
      "title": "ChapterAdaptationSourceRange",
      "type": "object"
    },
    "CharacterSettingSnapshot": {
      "additionalProperties": false,
      "description": "规划任务冻结的人物设定最小投影。",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "appearance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appearance"
        },
        "contentHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity"
        },
        "kind": {
          "const": "character",
          "default": "character",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "contentHash",
        "name"
      ],
      "title": "CharacterSettingSnapshot",
      "type": "object"
    },
    "CinematicReviewFinding": {
      "additionalProperties": false,
      "description": "面向作者的非阻断审镜发现。",
      "properties": {
        "evidence": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "message": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "scope": {
          "enum": [
            "plan",
            "scene",
            "beat",
            "shot"
          ],
          "title": "Scope",
          "type": "string"
        },
        "scopeKey": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scopekey"
        },
        "severity": {
          "enum": [
            "notice",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "scope",
        "message",
        "evidence",
        "suggestion"
      ],
      "title": "CinematicReviewFinding",
      "type": "object"
    },
    "CinematicSceneCandidate": {
      "additionalProperties": false,
      "description": "由时间、地点和连续行动空间决定的真实场景候选。",
      "properties": {
        "beats": {
          "items": {
            "$ref": "#/$defs/DramaticBeatCandidate"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "changeSummary": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Changesummary",
          "type": "string"
        },
        "locationLabel": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Locationlabel",
          "type": "string"
        },
        "objective": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "sceneKey": {
          "pattern": "^SC[0-9]{2,3}$",
          "title": "Scenekey",
          "type": "string"
        },
        "timeLabel": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Timelabel",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "sceneKey",
        "title",
        "locationLabel",
        "timeLabel",
        "objective",
        "changeSummary",
        "beats"
      ],
      "title": "CinematicSceneCandidate",
      "type": "object"
    },
    "CinematicShotCandidate": {
      "additionalProperties": false,
      "description": "候选镜头是一段连续机位和一个主要可见动作。",
      "properties": {
        "audienceGain": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Audiencegain",
          "type": "string"
        },
        "cameraAngle": {
          "enum": [
            "eye_level",
            "high_angle",
            "low_angle",
            "overhead",
            "dutch_angle"
          ],
          "title": "Cameraangle",
          "type": "string"
        },
        "cameraMovement": {
          "enum": [
            "locked",
            "pan",
            "tilt",
            "push_in",
            "pull_out",
            "tracking",
            "arc",
            "handheld",
            "focus_shift"
          ],
          "title": "Cameramovement",
          "type": "string"
        },
        "coveredGoalKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Coveredgoalkeys",
          "type": "array"
        },
        "cutReason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Cutreason",
          "type": "string"
        },
        "narrativePurpose": {
          "enum": [
            "establishing",
            "action",
            "dialogue",
            "reaction",
            "reveal",
            "insert",
            "transition",
            "atmosphere"
          ],
          "title": "Narrativepurpose",
          "type": "string"
        },
        "shotKey": {
          "pattern": "^S[0-9]{2,3}$",
          "title": "Shotkey",
          "type": "string"
        },
        "shotScale": {
          "enum": [
            "extreme_long",
            "long",
            "medium",
            "medium_close",
            "close",
            "extreme_close",
            "over_shoulder",
            "two_shot",
            "pov"
          ],
          "title": "Shotscale",
          "type": "string"
        },
        "soundDesign": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Sounddesign",
          "type": "string"
        },
        "sourceRanges": {
          "items": {
            "$ref": "#/$defs/ChapterAdaptationSourceRange"
          },
          "maxItems": 12,
          "title": "Sourceranges",
          "type": "array"
        },
        "sourceRelation": {
          "enum": [
            "direct",
            "derived",
            "supplemental"
          ],
          "title": "Sourcerelation",
          "type": "string"
        },
        "speechMode": {
          "enum": [
            "none",
            "sync",
            "offscreen",
            "voiceover"
          ],
          "title": "Speechmode",
          "type": "string"
        },
        "spokenText": {
          "anyOf": [
            {
              "maxLength": 800,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spokentext"
        },
        "storyFunction": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Storyfunction",
          "type": "string"
        },
        "timelineDurationMs": {
          "maximum": 15000,
          "minimum": 500,
          "title": "Timelinedurationms",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visualIntent": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Visualintent",
          "type": "string"
        }
      },
      "required": [
        "shotKey",
        "title",
        "narrativePurpose",
        "storyFunction",
        "audienceGain",
        "sourceRelation",
        "shotScale",
        "cameraAngle",
        "cameraMovement",
        "visualIntent",
        "speechMode",
        "soundDesign",
        "cutReason",
        "timelineDurationMs",
        "sourceRanges"
      ],
      "title": "CinematicShotCandidate",
      "type": "object"
    },
    "DramaticBeatCandidate": {
      "additionalProperties": false,
      "description": "戏剧节拍表达人物目标、信息、情绪、权力或行动结果的变化。",
