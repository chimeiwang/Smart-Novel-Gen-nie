{
  "$defs": {
    "ShotVisualReferenceSnapshot": {
      "additionalProperties": false,
      "description": "提示词与后续视频请求共同冻结的一份正式视觉参考。",
      "properties": {
        "assetId": {
          "minLength": 1,
          "title": "Assetid",
          "type": "string"
        },
        "assetSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assetsha256",
          "type": "string"
        },
        "canonVersionId": {
          "minLength": 1,
          "title": "Canonversionid",
          "type": "string"
        },
        "duty": {
          "enum": [
            "identity",
            "costume",
            "scene",
            "prop"
          ],
          "title": "Duty",
          "type": "string"
        },
        "excludeFeatures": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Excludefeatures",
          "type": "array"
        },
        "includeFeatures": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Includefeatures",
          "type": "array"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "settingId": {
          "minLength": 1,
          "title": "Settingid",
          "type": "string"
        },
        "settingKind": {
          "enum": [
            "character",
            "location",
            "item"
          ],
          "title": "Settingkind",
          "type": "string"
        },
        "settingName": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Settingname",
          "type": "string"
        },
        "strength": {
          "maximum": 100,
          "minimum": 1,
          "title": "Strength",
          "type": "integer"
        },
        "variantKey": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Variantkey",
          "type": "string"
        }
      },
      "required": [
        "canonVersionId",
        "assetId",
        "assetSha256",
        "settingKind",
        "settingId",
        "settingName",
        "duty",
        "variantKey",
        "label",
        "strength"
      ],
      "title": "ShotVisualReferenceSnapshot",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/video_adaptation/ShotVisualReferenceBundle/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一个目标镜头在任务创建时冻结的有序视觉参考集合。",
  "properties": {
    "references": {
      "items": {
        "$ref": "#/$defs/ShotVisualReferenceSnapshot"
      },
      "maxItems": 20,
      "title": "References",
      "type": "array"
    },
    "shotKey": {
      "pattern": "^S[0-9]{2,3}$",
      "title": "Shotkey",
      "type": "string"
    }
  },
  "required": [
    "shotKey"
  ],
  "title": "ShotVisualReferenceBundle",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video_adaptation.ShotVisualReferenceBundle"
}
