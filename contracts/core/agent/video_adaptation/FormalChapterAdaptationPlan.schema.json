{
  "$defs": {
    "BeatCoverageGoal": {
      "additionalProperties": false,
      "description": "一个节拍希望观众获得的内容，不预设必须使用哪类镜头完成。",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "goalKey": {
          "pattern": "^G[0-9]{2,3}$",
          "title": "Goalkey",
          "type": "string"
        },
        "kind": {
          "enum": [
            "story_information",
            "action",
            "emotion",
            "space",
            "relationship",
            "motif",
            "transition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "priority": {
          "enum": [
            "essential",
            "supporting"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "goalKey",
        "kind",
        "priority",
        "description"
      ],
      "title": "BeatCoverageGoal",
      "type": "object"
    },
    "ChapterAdaptationSourceRange": {
      "additionalProperties": false,
      "description": "相对于不可变章节全文的 Unicode code point 左闭右开范围。",
      "properties": {
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "sourceText": {
          "maxLength": 120000,
          "minLength": 1,
          "title": "Sourcetext",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "sourceText"
      ],
      "title": "ChapterAdaptationSourceRange",
      "type": "object"
    },
    "FormalCinematicScene": {
      "additionalProperties": false,
      "properties": {
        "beats": {
          "items": {
            "$ref": "#/$defs/FormalDramaticBeat"
          },
          "title": "Beats",
          "type": "array"
        },
        "changeSummary": {
          "title": "Changesummary",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locationLabel": {
          "title": "Locationlabel",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "sceneKey": {
          "pattern": "^SC[0-9]{2,3}$",
          "title": "Scenekey",
          "type": "string"
        },
        "timeLabel": {
          "title": "Timelabel",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sceneKey",
        "title",
        "locationLabel",
        "timeLabel",
        "objective",
        "changeSummary",
        "beats"
      ],
      "title": "FormalCinematicScene",
      "type": "object"
    },
    "FormalCinematicShot": {
      "additionalProperties": false,
      "description": "批准后具有数据库身份的正式镜头读模型。",
      "properties": {
        "audienceGain": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Audiencegain",
          "type": "string"
        },
        "cameraAngle": {
          "enum": [
            "eye_level",
            "high_angle",
            "low_angle",
            "overhead",
            "dutch_angle"
          ],
          "title": "Cameraangle",
          "type": "string"
        },
        "cameraMovement": {
          "enum": [
            "locked",
            "pan",
            "tilt",
            "push_in",
            "pull_out",
            "tracking",
            "arc",
            "handheld",
            "focus_shift"
          ],
          "title": "Cameramovement",
          "type": "string"
        },
        "coveredGoalKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Coveredgoalkeys",
          "type": "array"
        },
        "cutReason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Cutreason",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "narrativePurpose": {
          "enum": [
            "establishing",
            "action",
            "dialogue",
            "reaction",
            "reveal",
            "insert",
            "transition",
            "atmosphere"
          ],
          "title": "Narrativepurpose",
          "type": "string"
        },
        "shotKey": {
          "pattern": "^S[0-9]{2,3}$",
          "title": "Shotkey",
          "type": "string"
        },
        "shotScale": {
          "enum": [
            "extreme_long",
            "long",
            "medium",
            "medium_close",
            "close",
            "extreme_close",
            "over_shoulder",
            "two_shot",
            "pov"
          ],
          "title": "Shotscale",
          "type": "string"
        },
        "soundDesign": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Sounddesign",
          "type": "string"
        },
        "sourceRanges": {
          "items": {
            "$ref": "#/$defs/ChapterAdaptationSourceRange"
          },
          "maxItems": 12,
          "title": "Sourceranges",
          "type": "array"
        },
        "sourceRelation": {
          "enum": [
            "direct",
            "derived",
            "supplemental"
          ],
          "title": "Sourcerelation",
          "type": "string"
        },
        "speechMode": {
          "enum": [
            "none",
            "sync",
            "offscreen",
            "voiceover"
          ],
          "title": "Speechmode",
          "type": "string"
        },
        "spokenText": {
          "anyOf": [
            {
              "maxLength": 800,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spokentext"
        },
        "storyFunction": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Storyfunction",
          "type": "string"
        },
        "timelineDurationMs": {
          "maximum": 15000,
          "minimum": 500,
          "title": "Timelinedurationms",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visualIntent": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Visualintent",
          "type": "string"
        }
      },
      "required": [
        "shotKey",
        "title",
        "narrativePurpose",
        "storyFunction",
        "audienceGain",
        "sourceRelation",
        "shotScale",
        "cameraAngle",
        "cameraMovement",
        "visualIntent",
        "speechMode",
        "soundDesign",
        "cutReason",
        "timelineDurationMs",
        "sourceRanges",
        "id"
      ],
      "title": "FormalCinematicShot",
      "type": "object"
    },
    "FormalDramaticBeat": {
      "additionalProperties": false,
      "properties": {
        "beatKey": {
          "pattern": "^B[0-9]{2,3}$",
          "title": "Beatkey",
          "type": "string"
        },
        "coverageGoals": {
          "items": {
            "$ref": "#/$defs/BeatCoverageGoal"
          },
          "title": "Coveragegoals",
          "type": "array"
        },
        "dramaticTurn": {
          "title": "Dramaticturn",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/FormalCinematicShot"
          },
          "title": "Shots",
          "type": "array"
        },
        "sourceRanges": {
          "items": {
            "$ref": "#/$defs/ChapterAdaptationSourceRange"
          },
          "title": "Sourceranges",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "visualStrategy": {
          "title": "Visualstrategy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "beatKey",
        "title",
        "dramaticTurn",
        "visualStrategy",
        "coverageGoals",
        "sourceRanges",
        "shots"
      ],
      "title": "FormalDramaticBeat",
      "type": "object"
    }
  },
  "$id": "https://inkforge.local/contracts/agent/video_adaptation/FormalChapterAdaptationPlan/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adaptationId": {
      "minLength": 1,
      "title": "Adaptationid",
      "type": "string"
    },
    "basedOnVersionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Basedonversionid"
    },
    "episodeBreakAfterShotKeys": {
      "items": {
        "type": "string"
      },
      "title": "Episodebreakaftershotkeys",
      "type": "array"
    },
    "planVersionId": {
      "minLength": 1,
      "title": "Planversionid",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/FormalCinematicScene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "schemaVersion": {
      "const": "chapter_adaptation_plan_v3",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sourcehash",
      "type": "string"
    },
    "versionNo": {
      "minimum": 1,
      "title": "Versionno",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "planVersionId",
    "versionNo",
    "adaptationId",
    "sourceHash",
    "scenes"
  ],
  "title": "FormalChapterAdaptationPlan",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video_adaptation.FormalChapterAdaptationPlan"
}
