{
  "$id": "https://inkforge.local/contracts/agent/video_adaptation/CinematicReviewFinding/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "面向作者的非阻断审镜发现。",
  "properties": {
    "evidence": {
      "maxLength": 800,
      "minLength": 1,
      "title": "Evidence",
      "type": "string"
    },
    "message": {
      "maxLength": 600,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "scope": {
      "enum": [
        "plan",
        "scene",
        "beat",
        "shot"
      ],
      "title": "Scope",
      "type": "string"
    },
    "scopeKey": {
      "anyOf": [
        {
          "maxLength": 16,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scopekey"
    },
    "severity": {
      "enum": [
        "notice",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "suggestion": {
      "maxLength": 800,
      "minLength": 1,
      "title": "Suggestion",
      "type": "string"
    }
  },
  "required": [
    "severity",
    "scope",
    "message",
    "evidence",
    "suggestion"
  ],
  "title": "CinematicReviewFinding",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video_adaptation.CinematicReviewFinding"
}
