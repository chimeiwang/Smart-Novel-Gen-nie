      "title": "Resolution",
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "title": "Taskid",
      "type": "string"
    },
    "watermark": {
      "title": "Watermark",
      "type": "boolean"
    }
  },
  "required": [
    "taskId",
    "novelId",
    "inputHash",
    "model",
    "promptText",
    "ratio",
    "durationSeconds",
    "resolution",
    "generateAudio",
    "watermark"
  ],
  "title": "SeedanceRenderSubmitRequest",
  "type": "object",
  "x-inkforge-python-type": "inkforge_contracts.video_render.SeedanceRenderSubmitRequest"
}
