{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkforge.cn/contracts/agent-execution/system-purpose-registry.schema.json",
  "title": "InkForge Agent Execution System Purpose Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "purposes"
  ],
  "properties": {
    "registryVersion": {
      "const": "1"
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/systemPurpose"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "operationKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "versionedIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "systemPurpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "supported",
        "modelProfile",
        "outputSchema",
        "evidencePolicy",
        "lane",
        "stepBudgetProfile",
        "workflows",
        "parentOperations"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/name"
        },
        "supported": {
          "type": "boolean"
        },
        "modelProfile": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "outputSchema": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "evidencePolicy": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "lane": {
          "enum": [
            "interactive",
            "creative",
            "batch_media"
          ]
        },
        "stepBudgetProfile": {
          "$ref": "#/$defs/versionedIdentifier"
        },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "parentOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operationKey"
          }
        }
      }
    }
  }
}
