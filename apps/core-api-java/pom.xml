<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.inkforge</groupId>
    <artifactId>inkforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>inkforge-core-api</artifactId>
  <name>InkForge Java Core API</name>
  <description>用于完整替换 Python Core 的 Spring Boot 模块化单体</description>

  <dependencies>
    <dependency>
      <groupId>cn.inkforge</groupId>
      <artifactId>inkforge-service-auth</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>cn.inkforge</groupId>
      <artifactId>inkforge-service-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jooq</groupId>
      <artifactId>jooq</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aliyun</groupId>
      <artifactId>dypnsapi20170525</artifactId>
      <version>${aliyun-dypnsapi.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aliyun</groupId>
      <artifactId>captcha20230305</artifactId>
      <version>${aliyun-captcha.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <directory>../../scripts/migrations</directory>
        <includes>
          <include>20260827_user_phone_identity.sql</include>
          <include>20260831_durable_agent_execution.sql</include>
        </includes>
        <targetPath>migrations</targetPath>
      </testResource>
      <testResource>
        <directory>../../contracts/core/model-grant-fixtures</directory>
        <targetPath>model-grant-fixtures</targetPath>
      </testResource>
      <testResource>
        <directory>../../contracts/core/behavior-fixtures</directory>
        <targetPath>behavior-fixtures</targetPath>
      </testResource>
    </testResources>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>../../contracts/agent-execution</directory>
        <includes>
          <include>*.json</include>
        </includes>
        <targetPath>agent-execution</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-generated-jooq-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/generated/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.24.0</version>
        <executions>
          <execution>
            <id>generate-frozen-core-api-interfaces</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../../contracts/core/full-openapi-java-baseline.json</inputSpec>
              <generatorName>spring</generatorName>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <modelPackage>cn.inkforge.contracts.api</modelPackage>
              <apiPackage>cn.inkforge.core.generated.api</apiPackage>
              <generateApis>true</generateApis>
              <generateModels>false</generateModels>
              <generateSupportingFiles>false</generateSupportingFiles>
              <!--
                OpenAPI Generator 会把写作启动接口匿名 anyOf 的标题 Body 错误摊平成三种请求字段的并集，
                进而给每个分支都附加另外两个分支的必填校验。接口层只把这一匿名联合体映射为 JSON 树，
                由 writing 模块按照冻结契约执行严格的分支判别、字段校验和跨字段校验。
              -->
              <schemaMappings>
                <schemaMapping>Body=WritingRunStartBody</schemaMapping>
                <schemaMapping>WritingEventStream=SseEmitter</schemaMapping>
                <schemaMapping>BinaryFileStream=StreamingResponseBody</schemaMapping>
              </schemaMappings>
              <importMappings>
                <importMapping>WritingRunStartBody=cn.inkforge.core.generated.model.WritingRunStartBody</importMapping>
                <importMapping>SseEmitter=org.springframework.web.servlet.mvc.method.annotation.SseEmitter</importMapping>
                <importMapping>StreamingResponseBody=org.springframework.web.servlet.mvc.method.annotation.StreamingResponseBody</importMapping>
              </importMappings>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <skipDefaultInterface>true</skipDefaultInterface>
                <useTags>true</useTags>
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <useBeanValidation>true</useBeanValidation>
                <useSpringBuiltInValidation>true</useSpringBuiltInValidation>
                <useResponseEntity>true</useResponseEntity>
                <openApiNullable>false</openApiNullable>
                <annotationLibrary>none</annotationLibrary>
                <documentationProvider>none</documentationProvider>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
              <globalProperties>
                <apis/>
                <apiDocs>false</apiDocs>
                <apiTests>false</apiTests>
              </globalProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    只在人工执行 -Pjooq-codegen-dev 时读取 novelwriterdev 元数据。常规构建只编译已审查的生成代码，
    不连接数据库，也不会执行 DDL。
  -->
  <profiles>
    <profile>
      <id>jooq-codegen-dev</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen-maven</artifactId>
            <version>${jooq.version}</version>
            <executions>
              <execution>
                <id>generate-jooq-from-dev-schema</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
              </execution>
            </executions>
            <dependencies>
              <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <jdbc>
                <driver>org.postgresql.Driver</driver>
                <url>${env.INKFORGE_JOOQ_JDBC_URL}</url>
                <user>${env.INKFORGE_JOOQ_DATABASE_USER}</user>
                <password>${env.INKFORGE_JOOQ_DATABASE_PASSWORD}</password>
              </jdbc>
              <generator>
                <database>
                  <name>org.jooq.meta.postgres.PostgresDatabase</name>
                  <inputSchema>public</inputSchema>
                  <includes>.*</includes>
                  <includeSystemTables>false</includeSystemTables>
                  <includeSystemSequences>false</includeSystemSequences>
                  <includeRoutines>false</includeRoutines>
                </database>
                <generate>
                  <deprecated>false</deprecated>
                  <records>true</records>
                  <relations>true</relations>
                  <generatedAnnotation>true</generatedAnnotation>
                </generate>
                <target>
                  <packageName>cn.inkforge.core.db.generated</packageName>
                  <directory>${project.basedir}/src/generated/java</directory>
                  <clean>true</clean>
                </target>
              </generator>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
