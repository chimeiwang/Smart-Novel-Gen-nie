# 服务器开发数据副本
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://用户名:密码@服务器地址:5432/novelwriterdev
REDIS_URL=redis://:密码@服务器地址:6379/1
JWT_SECRET=请替换为至少32字节的本地会话密钥

# 默认不发送真实短信；只在隔离开发库已应用具名迁移并准备授权测试号码后开启。
PHONE_AUTH_ENABLED=false
PHONE_AUTH_SEND_ENABLED=false
USERNAME_REGISTRATION_ENABLED=true
PHONE_AUTH_CONSENT_VERSION=2026-08-27
PHONE_AUTH_REDIS_PREFIX=phone-auth:local:v1:
PHONE_AUTH_HMAC_SECRET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
ALIYUN_PNVS_SCHEME_NAME=
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_SCENE_ID=

# 本地三服务地址
CORE_API_INTERNAL_URL=http://127.0.0.1:8000
AGENT_SERVICE_URL=http://127.0.0.1:8001
CORE_API_URL=http://127.0.0.1:8000
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
AGENT_SERVICE_CIDRS=127.0.0.1/32,::1/128
TRUSTED_CORE_CIDRS=127.0.0.1/32,::1/128

# 使用服务密钥生成脚本创建，路径相对于仓库根目录
CORE_SERVICE_PRIVATE_KEY_PATH=infra/secrets/core-to-agent-private.pem
AGENT_SERVICE_PUBLIC_KEY_PATH=infra/secrets/agent-to-core-jwks.json
CORE_SERVICE_PUBLIC_KEY_PATH=infra/secrets/core-to-agent-jwks.json
AGENT_SERVICE_PRIVATE_KEY_PATH=infra/secrets/agent-to-core-private.pem

# 本地默认使用不计费的确定性模拟模型
MODEL_PROVIDER=fake
# 本地 fake 不请求供应商；如切换真实兼容服务，必须显式选择 generic 或 deepseek_v4，不能根据 URL 猜 profile。
# 可选值：OPENAI_COMPATIBILITY_PROFILE=generic|deepseek_v4
OPENAI_COMPATIBILITY_PROFILE=generic
OPENAI_API_KEY=
# 官方 DeepSeek 根 URL 示例；不要记录或提交 API key 值。
OPENAI_BASE_URL=https://api.deepseek.com
# 官方 DeepSeek 地址会自动派生 /beta；自定义 DeepSeek 网关必须显式填写 strict 根地址。
OPENAI_STRICT_BASE_URL=
OPENAI_MODEL=deepseek-v4-flash
# 本地也使用同一有界并行预算；需要复现串行行为时改为 1。
AGENT_MAX_CONCURRENCY=3
# 本地人工工作流日志目录必须可写；生产 Compose 会覆盖为 /data/agent-logs。
WORKFLOW_HUMAN_LOG_DIR=./.data/agent-logs

# 本地火山方舟占位；填入密钥后先配置，再单独开启真实渲染。
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-5-260628
SEEDANCE_CONFIGURED=false
SEEDANCE_ENABLED=false
# 有视觉参考的真实调用需要供应商可访问的 HTTPS 基址和至少 32 字节随机密钥。
VIDEO_PROVIDER_MEDIA_BASE_URL=
VIDEO_PROVIDER_MEDIA_TOKEN_SECRET=
SEEDANCE_RESULT_ALLOWED_HOST_SUFFIXES=.volces.com
# 仅用于验证长篇设定快照和提示词格式；不会提交真实 Seedance 任务。
VIDEO_PREVIEW_ENABLED=true
# npm run dev 会在未填写时按用户和工作副本生成稳定值；直接启动 Core 时必须显式填写。
VIDEO_DISPATCH_NAMESPACE=
# 只领取上面命名空间创建的任务；关闭后视频 API 仍可读取，但不会后台投递。
VIDEO_DISPATCH_ENABLED=true
