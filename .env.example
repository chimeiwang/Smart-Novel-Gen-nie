# 宿主机 Nginx 通过回环地址代理到此端口；生产部署必须保持 INKFORGE_PORT=43120，且不得直接向公网暴露。
INKFORGE_PORT=43120
INKFORGE_IMAGE_TAG=latest

# GitHub production environment 另需配置 DEPLOY_SSH_KNOWN_HOSTS Secret。
# 该值只能来自管理员离线核验的 SSH 主机公钥，不属于服务器或容器的 .env。

# 现有宿主机 PostgreSQL 数据库。应用启动永不自动执行迁移；生产迁移必须另行审批。
DATABASE_URL=postgresql+asyncpg://inkforge:请替换@host.docker.internal:5432/novelwriter

# 浏览器会话签名密钥，至少 32 个 UTF-8 字节。
JWT_SECRET=请替换为随机密钥

# 生产 HTTPS 必须签发 Secure 会话 Cookie，不得开启明文 HTTP 认证。
ALLOW_INSECURE_HTTP_AUTH=false

# 使用 scripts/generate_service_keys.py 生成，目录不得提交到仓库。
SERVICE_KEYS_DIR=./secrets
CORE_SERVICE_KEY_ID=core-api-v1
AGENT_SERVICE_KEY_ID=agent-service-v1

# 模型服务
MODEL_PROVIDER=openai_compatible
# 显式选择兼容协议：generic 使用通用 ChatOpenAI；deepseek_v4 使用 DeepSeek 原始 JSON transport。
# 可选值：OPENAI_COMPATIBILITY_PROFILE=generic|deepseek_v4；profile 不根据 URL 推断。
OPENAI_COMPATIBILITY_PROFILE=deepseek_v4
OPENAI_API_KEY=
# DeepSeek 官方根 URL；不要把 API key 值写入仓库、日志或示例文件。
OPENAI_BASE_URL=https://api.deepseek.com
# 官方 DeepSeek 地址会自动派生 /beta；自定义 DeepSeek 网关必须显式填写 strict 根地址。
OPENAI_STRICT_BASE_URL=
OPENAI_MODEL=deepseek-v4-flash
MODEL_MAX_OUTPUT_TOKENS=384000
# 2 核 2 GB 默认允许三个不同项目任务和三个模型调用；同项目始终串行，资源压力时可降为 2 或 1。
AGENT_MAX_CONCURRENCY=3
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
# 仅在以上三项均已配置时启用；Core 与 Agent 会读取同一开关。
RAG_INDEX_ENABLED=false

# Seedance 2.5 密钥只注入 Agent；通过受控验收前保持启用开关关闭。
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-5-260628
SEEDANCE_CONFIGURED=false
SEEDANCE_ENABLED=false
# Core 用于短时参考图地址和结果归档；真实渲染关闭时可留空。
VIDEO_PROVIDER_MEDIA_BASE_URL=
VIDEO_PROVIDER_MEDIA_TOKEN_SECRET=
SEEDANCE_RESULT_ALLOWED_HOST_SUFFIXES=.volces.com
# 目标视频 schema 上线前，生产必须保持开发预览关闭。
VIDEO_PREVIEW_ENABLED=false

# Agent 队列终态幂等记录保留天数，最少 1 天。
QUEUE_TERMINAL_RETENTION_DAYS=7

# 默认关闭人工调试日志读取接口。
WORKFLOW_EVENT_DEBUG_ENABLED=false
