<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.inkforge</groupId>
    <artifactId>inkforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>inkforge-service-contracts</artifactId>
  <name>InkForge Java 服务契约</name>

  <dependencies>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.11</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.24.0</version>
        <executions>
          <execution>
            <id>generate-frozen-core-models</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../../contracts/core/full-openapi-java-baseline.json</inputSpec>
              <generatorName>spring</generatorName>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <templateDirectory>${project.basedir}/src/main/openapi-templates</templateDirectory>
              <modelPackage>cn.inkforge.contracts.api</modelPackage>
              <apiPackage>cn.inkforge.contracts.api.unsupported</apiPackage>
              <generateApis>false</generateApis>
              <generateModels>true</generateModels>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <useBeanValidation>true</useBeanValidation>
                <performBeanValidation>true</performBeanValidation>
                <disableDiscriminatorJsonIgnoreProperties>true</disableDiscriminatorJsonIgnoreProperties>
                <openApiNullable>true</openApiNullable>
                <containerDefaultToNull>true</containerDefaultToNull>
                <generatedConstructorWithRequiredArgs>true</generatedConstructorWithRequiredArgs>
                <annotationLibrary>none</annotationLibrary>
                <documentationProvider>none</documentationProvider>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
              <globalProperties>
                <models/>
                <modelDocs>false</modelDocs>
                <modelTests>false</modelTests>
              </globalProperties>
            </configuration>
          </execution>
          <execution>
            <id>generate-frozen-agent-models</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../../contracts/agent-service/openapi-java-baseline.json</inputSpec>
              <generatorName>spring</generatorName>
              <output>${project.build.directory}/generated-sources/agent-openapi</output>
              <modelPackage>cn.inkforge.contracts.agent</modelPackage>
              <apiPackage>cn.inkforge.contracts.agent.unsupported</apiPackage>
              <generateApis>false</generateApis>
              <generateModels>true</generateModels>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <useBeanValidation>true</useBeanValidation>
                <performBeanValidation>true</performBeanValidation>
                <openApiNullable>false</openApiNullable>
                <containerDefaultToNull>true</containerDefaultToNull>
                <generatedConstructorWithRequiredArgs>true</generatedConstructorWithRequiredArgs>
                <annotationLibrary>none</annotationLibrary>
                <documentationProvider>none</documentationProvider>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
              <globalProperties>
                <models/>
                <modelDocs>false</modelDocs>
                <modelTests>false</modelTests>
              </globalProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
